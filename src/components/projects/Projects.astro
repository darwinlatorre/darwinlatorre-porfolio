---
import AuthPreview from './AuthPreview.astro';
import { siGithub } from 'simple-icons';
import { profile, projects } from '../../data/portfolio';
---

<section id="projects" class="screen projects" aria-labelledby="projects-title" data-projects>
	<div class="projects-content" tabindex="0" aria-label="Projects content" data-projects-content>
		<h2 id="projects-title" class="projects-title"><span aria-hidden="true">&gt;</span> projects</h2>
		<div class="projects-grid" role="region" aria-label="Featured projects carousel" data-project-carousel>
			{
				projects.map((project) => (
					<article
						id={project.id}
						class:list={['project-card', { 'has-page-preview': Boolean(project.preview) }]}
						data-preview-title={project.preview ? project.name : undefined}
						data-project-card
					>
						<div class="project-preview" aria-hidden="true" inert>
							{project.preview ? (
								<img src={project.preview} alt="" width="850" height="1400" loading="lazy" decoding="async" draggable="false" />
							) : (
								<AuthPreview />
							)}
						</div>
						<a class="project-main-link" href={project.href} target="_blank" rel="noreferrer" aria-label={`Open ${project.name}`}>
							<div class="project-meta">
								<h3>{project.name}</h3>
								<span class="project-description">{project.description}</span>
							</div>
						</a>
						{project.repository && (
							<a class="project-repository" href={project.repository} target="_blank" rel="noreferrer" aria-label={`View ${project.name} repository on GitHub`}>
								<svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
									<path fill="currentColor" d={siGithub.path} />
								</svg>
							</a>
						)}
					</article>
				))
			}
			<article id="project-github" class="project-card github-card" data-project-card>
				<div class="github-card-art" aria-hidden="true">
					<svg viewBox="0 0 24 24" width="80" height="80">
						<path fill="currentColor" d={siGithub.path} />
					</svg>
					<span>More code. More projects.</span>
				</div>
				<a class="project-main-link" href={profile.githubHref} target="_blank" rel="noreferrer" aria-label="View Darwin Latorre's GitHub profile">
					<div class="project-meta">
						<h3>GitHub / darwinlatorre</h3>
						<span class="project-description">Explore all my repositories and contributions.</span>
					</div>
				</a>
			</article>
		</div>
		<a href={profile.githubHref} target="_blank" rel="noreferrer" class="projects-github-bar github-profile-button">
				<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
					<path fill="currentColor" d={siGithub.path} />
				</svg>
				<span>GitHub / darwinlatorre</span>
		</a>
	</div>
</section>

<style>
	.projects {
		--projects-max-width: 82rem;
		--project-card-max-height: 50rem;
		--project-name-font-size: clamp(1.3rem, 1.95vw, 1.75rem);
		--projects-gap: 1.5rem;
		--projects-header-space: calc(var(--page-inset) + var(--control-offset) + 4.75rem);
		--projects-footer-space: calc(var(--page-inset) + var(--control-offset) + 2.75rem);

		display: grid;
		container-type: inline-size;
		overflow: hidden;
		grid-template-rows: var(--projects-header-space) minmax(0, 1fr) var(--projects-footer-space);
	}

	.projects-content {
		display: grid;
		width: min(var(--content-max-width), 100%);
		height: 100%;
		min-height: 0;
		min-width: 0;
		margin-inline: auto;
		padding: 0.75rem var(--content-gutter);
		overflow-y: auto;
		grid-row: 2;
		grid-template-rows: auto minmax(0, 1fr) auto;
		align-content: safe center;
		gap: var(--projects-gap);
		scrollbar-width: none;
	}

	.projects-content::-webkit-scrollbar {
		display: none;
	}

	.projects-title {
		width: min(var(--projects-max-width), 100%);
		margin: 0 auto;
		color: var(--color-text);
		font-size: var(--section-heading-font-size);
		font-weight: 400;
		letter-spacing: 0.01em;
		line-height: 1.4;
	}

	.projects-title span {
		color: var(--color-accent);
	}

	.projects-content.is-scroll-contained {
		overscroll-behavior-y: contain;
	}

	.projects-content:focus-visible {
		outline: 1px solid var(--color-accent-muted);
		outline-offset: -4px;
	}

	.projects-github-bar {
		display: flex;
		width: min(var(--projects-max-width), 100%);
		margin-inline: auto;
		padding: 0.65rem;
		justify-content: center;
		border: var(--border-width) solid var(--color-border);
		background: color-mix(in srgb, var(--color-surface-raised) 35%, transparent);
	}

	.github-profile-button {
		display: inline-flex;
		min-height: 2.75rem;
		padding: 0.5rem 1rem;
		align-items: center;
		gap: 0.6rem;
		cursor: pointer;
		color: var(--color-text);
		font-size: 0.85rem;
		text-decoration: none;
		transition: color 180ms ease;
	}

	.github-profile-button:hover {
		color: var(--color-accent);
	}

	.github-profile-button:focus-visible {
		outline: 1px solid var(--color-accent);
		outline-offset: 2px;
	}

	.projects-grid {
		display: grid;
		width: min(var(--projects-max-width), 100%);
		height: 100%;
		max-height: var(--project-card-max-height);
		min-height: 0;
		margin-inline: auto;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		grid-template-rows: minmax(0, 1fr);
		align-self: center;
		gap: var(--projects-gap);
	}

	.project-card {
		position: relative;
		display: grid;
		height: 100%;
		min-width: 0;
		min-height: 0;
		container-type: size;
		grid-template-rows: minmax(0, 1fr) auto;
		overflow: hidden;
		border: var(--border-width) solid var(--color-border);
		background: color-mix(in srgb, var(--color-surface-raised) 24%, transparent);
		color: var(--color-text);
		text-decoration: none;
		transition: border-color 220ms ease, background-color 220ms ease;
	}

	.project-preview {
		position: relative;
		min-height: 0;
		grid-row: 1;
		container-type: size;
		overflow: hidden;
		background: var(--color-surface-raised);
		pointer-events: none;
		user-select: none;
	}

	.project-preview img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
		object-position: top;
	}

	.github-card {
		display: none;
	}

	.github-card-art {
		display: flex;
		min-height: 0;
		padding: clamp(0.75rem, 2vh, 2rem) 1rem;
		overflow: hidden;
		align-items: center;
		justify-content: center;
		flex-direction: column;
		gap: clamp(0.5rem, 2vh, 1.5rem);
		color: var(--color-accent);
		text-align: center;
	}

	.github-card-art svg {
		max-height: 50%;
	}

	.github-card-art span {
		color: var(--color-text-muted);
		font-size: 0.85rem;
	}

	.project-main-link {
		position: relative;
		z-index: 1;
		min-height: 0;
		/* Keep a visible preview; long descriptions scroll inside short cards. */
		max-height: 55cqh;
		overflow-y: auto;
		grid-row: 2;
		scrollbar-width: none;
		color: inherit;
		text-decoration: none;
	}

	.project-main-link::-webkit-scrollbar {
		display: none;
	}

	/* Reserve the collapsed title row so page screenshots never resize on reveal. */
	.project-card.has-page-preview::after {
		min-width: 0;
		padding: 0.8rem 2.5rem 0.8rem 1rem;
		grid-row: 2;
		border-top: 1px solid transparent;
		content: attr(data-preview-title);
		visibility: hidden;
	}

	.has-page-preview .project-main-link {
		position: absolute;
		inset: auto 0 0;
	}

	.project-meta {
		position: relative;
		display: grid;
		padding: 0.8rem 2.5rem 0.8rem 1rem;
		grid-template-rows: auto 0fr;
		gap: 0;
		border-top: 1px solid var(--color-border);
		background: color-mix(in srgb, var(--color-surface) 96%, transparent);
		backdrop-filter: blur(3px);
		transition: grid-template-rows 280ms var(--ease-out), background-color 280ms ease;
	}

	.project-card h3,
	.project-card.has-page-preview::after {
		margin: 0;
		font-size: var(--project-name-font-size);
		font-weight: 400;
		letter-spacing: -0.025em;
		line-height: 1.4;
		text-align: left;
		overflow-wrap: anywhere;
	}

	.project-description {
		display: block;
		min-height: 0;
		overflow: hidden;
		padding-right: 0.3rem;
		color: color-mix(in srgb, var(--color-text) 92%, var(--color-text-muted));
		font-size: var(--terminal-font-size);
		line-height: 1.5;
		opacity: 0;
		transform: translateY(0.6rem);
		transition: opacity 220ms ease 40ms, transform 280ms var(--ease-out), margin-top 280ms var(--ease-out);
	}

	.project-card:hover .project-meta,
	.project-card:has(:focus-visible) .project-meta {
		grid-template-rows: auto 1fr;
		background: color-mix(in srgb, var(--color-surface-raised) 72%, transparent);
		backdrop-filter: blur(12px);
	}

	.project-card:hover .project-description,
	.project-card:has(:focus-visible) .project-description {
		margin-top: 0.5rem;
		opacity: 1;
		transform: translateY(0);
	}

	.project-repository {
		position: absolute;
		z-index: 2;
		right: 0.75rem;
		bottom: 0.75rem;
		display: inline-flex;
		width: 2.75rem;
		min-height: 2.75rem;
		padding: 0.35rem;
		align-items: center;
		justify-content: center;
		border: 0;
		background: transparent;
		color: var(--color-accent);
		text-decoration: none;
		opacity: 0;
		pointer-events: none;
		transform: translateY(-4px);
		transition: opacity 180ms ease, transform 180ms ease;
	}

	.project-card:hover .project-repository,
	.project-card:has(:focus-visible) .project-repository,
	.project-repository:focus-visible {
		opacity: 1;
		pointer-events: auto;
		transform: translateY(0);
	}

	.project-repository:hover,
	.project-repository:focus-visible {
		color: var(--color-accent);
		transform: scale(1.12);
	}

	.project-card:hover,
	.project-card:has(:focus-visible) {
		border-color: color-mix(in srgb, var(--color-accent) 66%, var(--color-text));
		background: color-mix(in srgb, var(--color-accent) 5%, var(--color-surface));
	}

	.project-main-link:focus-visible,
	.project-repository:focus-visible {
		outline: 1px solid var(--color-accent);
		outline-offset: -3px;
	}

	@media (min-width: 48.01rem) {
		.projects-content {
			--projects-inline-padding: clamp(2rem, 4vw, 4rem);
			--projects-grid-width: min(var(--projects-max-width), calc(min(96rem, 100cqw) - 2 * var(--projects-inline-padding)));
			/* Match the screenshots' 850×1400 ratio plus the collapsed details row. */
			--project-fitted-height: calc(
				((var(--projects-grid-width) - 2 * var(--projects-gap)) / 3 - 2px) * 1400 / 850
				+ var(--project-name-font-size) * 1.4 + 1.6rem + 3px
			);

			width: min(96rem, 100%);
			padding-inline: var(--projects-inline-padding);
			grid-template-rows: auto minmax(0, min(var(--project-card-max-height), var(--project-fitted-height))) auto;
		}
	}

	@media (min-width: 48.01rem) and (max-height: 45rem) {
		.projects {
			--projects-header-space: calc(var(--page-inset) + var(--control-offset) + 3rem);
			--projects-footer-space: calc(var(--page-inset) + var(--control-offset) + 1.75rem);
			--projects-gap: 0.75rem;
		}

		.projects-content {
			padding-block: 0.5rem;
		}
	}

	@media (max-width: 48rem) {
		.projects {
			--projects-header-space: calc(var(--page-inset) + var(--control-offset) + 2.5rem);
			--projects-footer-space: calc(var(--page-inset) + var(--control-offset) + 1.5rem);
		}

		.projects-content {
			padding-inline: var(--content-gutter);
			overflow: hidden;
			grid-template-rows: auto minmax(0, 1fr);
			gap: 0.75rem;
		}

		.projects-grid {
			width: 100%;
			height: 100%;
			max-height: none;
			min-height: 0;
			padding-block: 0.25rem;
			padding-inline: max(0px, calc((100% - 30rem) / 2));
			overflow-x: auto;
			overflow-y: hidden;
			grid-template-columns: none;
			grid-template-rows: minmax(0, 1fr);
			grid-auto-flow: column;
			grid-auto-columns: min(100%, 30rem);
			gap: 1rem;
			scroll-snap-type: x mandatory;
			overscroll-behavior-x: contain;
			overscroll-behavior-y: auto;
			scrollbar-width: none;
		}

		.projects-grid::-webkit-scrollbar {
			display: none;
		}

		.projects-github-bar {
			display: none;
		}

		.projects-title {
			width: 100%;
		}

		.project-card {
			scroll-snap-align: center;
			scroll-snap-stop: always;
		}

		.github-card {
			display: grid;
		}

		.project-card h3,
		.project-card.has-page-preview::after {
			font-size: 1.35rem;
		}

		.project-description {
			font-size: 0.85rem;
		}
	}

	@media (max-width: 48rem), (hover: none), (pointer: coarse) {
		.project-meta {
			grid-template-rows: auto 1fr;
		}

		.project-meta,
		.project-card.has-page-preview::after {
			padding-right: 1rem;
		}

		.project-card:has(.project-repository) .project-meta,
		.project-card.has-page-preview:has(.project-repository)::after {
			padding-right: 4rem;
		}
		.project-repository {
			opacity: 1;
			pointer-events: auto;
			transform: none;
		}

		.project-card .project-description {
			margin-top: 0.5rem;
			opacity: 1;
			transform: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.project-card,
		.project-repository,
		.project-meta,
		.project-description,
		.github-profile-button {
			transition: none;
		}
	}
</style>
