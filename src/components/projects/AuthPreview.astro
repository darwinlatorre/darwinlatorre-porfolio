---
import { ShieldCheck } from '@lucide/astro';
---

<div class="auth-preview">
	<div class="preview-heading">
		<span class="eyebrow">IDENTITY GATEWAY</span>
		<p>One identity.</p>
		<div class="stack-highlight"><strong>Java</strong><span>+</span><strong>Spring Boot</strong></div>
	</div>
	<div class="security-core">
		<div class="orbit orbit-outer"></div>
		<div class="orbit orbit-inner"></div>
		<span class="orbit-node node-top"></span>
		<span class="orbit-node node-bottom"></span>
		<div class="shield-core"><ShieldCheck size={58} stroke-width={1.1} /></div>
		<span class="core-caption">JWT · ROLE-BASED ACCESS</span>
	</div>
	<div class="token-panel">
		<div class="token-header"><span>ACCESS TOKEN</span><span class="token-badge">BEARER</span></div>
		<div class="token-string"><span>eyJhbGciOiJIUzI1NiJ9</span><span>.eyJzdWIiOiJ1c2VyIn0</span><span>.signature</span></div>
	</div>
</div>

<style>
	.auth-preview {
		--auth-unit: min(1rem, 2.5cqh, 5cqw);

		position: relative;
		display: flex;
		height: 100%;
		padding: calc(var(--auth-unit) * 0.85) calc(var(--auth-unit) * 1.5) calc(var(--auth-unit) * 1.25);
		overflow: hidden;
		flex-direction: column;
		background: #101417;
		color: #edf6f3;
		font-family: inherit;
		font-size: var(--auth-unit);
		line-height: 1.4;
	}

	.token-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: calc(var(--auth-unit) * 0.5);
		color: #a5bfb5;
		font-size: calc(var(--auth-unit) * 0.5);
		letter-spacing: 0.08em;
	}
	.preview-heading { position: relative; margin-top: 0; margin-left: calc(var(--auth-unit) * -0.35); }
	.eyebrow { color: #8edec4; font-size: calc(var(--auth-unit) * 0.55); letter-spacing: 0.18em; }
	.preview-heading p { margin: calc(var(--auth-unit) * 0.65) 0 0; font-size: calc(var(--auth-unit) * 1.8); line-height: 1.25; letter-spacing: -0.055em; }
	.stack-highlight { display: flex; margin-top: var(--auth-unit); align-items: center; flex-wrap: wrap; gap: calc(var(--auth-unit) * 0.6); font-size: calc(var(--auth-unit) * 1.3); }
	.stack-highlight strong { color: #a4f3d6; font-weight: 600; }
	.stack-highlight strong:first-child { color: #ef6569; }
	.stack-highlight span { color: #59766c; font-size: calc(var(--auth-unit) * 0.75); }
	.security-core { position: relative; width: 100%; min-height: calc(var(--auth-unit) * 13); margin-block: auto; }
	.orbit { position: absolute; top: 50%; left: 50%; border: 1px solid #78d9be26; border-radius: 50%; transform: translate(-50%, -50%); }
	.orbit-outer { width: calc(var(--auth-unit) * 12); height: calc(var(--auth-unit) * 12); }
	.orbit-inner { width: calc(var(--auth-unit) * 9); height: calc(var(--auth-unit) * 9); border-style: dashed; border-color: #78d9be38; }
	.shield-core {
		position: absolute;
		top: 50%;
		left: 50%;
		display: grid;
		width: calc(var(--auth-unit) * 6.4);
		height: calc(var(--auth-unit) * 6.4);
		place-items: center;
		border: 1px solid #91e9cb50;
		border-radius: calc(var(--auth-unit) * 1.7);
		background: linear-gradient(140deg, #264f46, #112721);
		color: #a4f3d6;
		box-shadow: 0 0 25px #91e9cb26, 0 0 60px #63dab11f,
			inset 0 0 24px #91e9cb18;
		transform: translate(-50%, -50%) rotate(-8deg);
	}
	.shield-core :global(svg) { width: calc(var(--auth-unit) * 3.625); height: calc(var(--auth-unit) * 3.625); transform: rotate(8deg); }
	.orbit-node { position: absolute; left: 50%; width: calc(var(--auth-unit) * 0.4); height: calc(var(--auth-unit) * 0.4); border-radius: 50%; background: #9beccd; }
	.node-top { top: calc(50% - var(--auth-unit) * 6.2); }
	.node-bottom { top: calc(50% + var(--auth-unit) * 5.8); }
	.core-caption { position: absolute; bottom: calc(var(--auth-unit) * -1.5); width: 100%; color: #799b90; font-size: calc(var(--auth-unit) * 0.5); letter-spacing: 0.08em; text-align: center; }
	.token-panel { position: relative; margin-top: calc(var(--auth-unit) * 3); padding: calc(var(--auth-unit) * 0.9); border: 1px solid #6ca78e35; border-radius: calc(var(--auth-unit) * 0.55); background: #101c20e6; }
	.token-badge { padding: calc(var(--auth-unit) * 0.25) calc(var(--auth-unit) * 0.35); border-radius: calc(var(--auth-unit) * 0.2); background: #29473b; color: #9beccd; font-size: calc(var(--auth-unit) * 0.45); }
	.token-string { display: grid; margin-block: calc(var(--auth-unit) * 0.85); overflow: hidden; gap: calc(var(--auth-unit) * 0.2); font-size: calc(var(--auth-unit) * 0.65); white-space: nowrap; }
	.token-string span:nth-child(1) { color: #df9fb6; }
	.token-string span:nth-child(2) { color: #b4abd9; }
	.token-string span:nth-child(3) { color: #8fdbbc; }

	.security-core,
	.token-panel {
		transition: transform 360ms var(--ease-out);
	}

	/* Keep hover offsets proportional to the preview's available space. */
	.security-core {
		transform: translateY(calc(var(--auth-unit) * 0.5));
	}

	.token-panel {
		transform: translateY(calc(var(--auth-unit) * 0.5));
	}

	.shield-core::after {
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background: linear-gradient(135deg, #c8ffe41a, transparent 48%);
		pointer-events: none;
		content: '';
	}

	:global(.project-card:has(:focus-visible)) .security-core,
	:global(.project-card:has(:focus-visible)) .token-panel {
		transform: translateY(0);
	}

	@media (any-hover: hover) {
		:global(.project-card:hover) .security-core,
		:global(.project-card:hover) .token-panel {
			transform: translateY(0);
		}
	}

	@media (any-hover: none) {
		.security-core,
		.token-panel {
			transform: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.security-core,
		.token-panel {
			transition: none;
		}
	}

	@media (max-width: 48rem) {
		.auth-preview { --auth-unit: min(1rem, 3.2cqh, 5cqw); }
		.security-core { min-height: calc(var(--auth-unit) * 8); }
		.orbit-outer { width: calc(var(--auth-unit) * 7); height: calc(var(--auth-unit) * 7); }
		.orbit-inner { width: calc(var(--auth-unit) * 6); height: calc(var(--auth-unit) * 6); }
		.shield-core { width: calc(var(--auth-unit) * 4.8); height: calc(var(--auth-unit) * 4.8); border-radius: calc(var(--auth-unit) * 1.2); }
		.shield-core :global(svg) { width: calc(var(--auth-unit) * 2.75); height: calc(var(--auth-unit) * 2.75); }
		.node-top { top: calc(50% - var(--auth-unit) * 3.7); }
		.node-bottom { top: calc(50% + var(--auth-unit) * 3.3); }
		.token-panel { margin-top: calc(var(--auth-unit) * 2.4); }
	}
</style>
