---
import { Folder, House } from '@lucide/astro';

const menuItems = [
	{ label: 'About', href: '#about', external: false },
	{ label: 'Projects', href: 'https://github.com/darwinlatorre', external: true },
	{ label: 'Experience', href: '#experience', external: false },
	{ label: 'Services', href: '#services', external: false },
	{ label: 'Certificates', href: '#certificates', external: false },
];

interface Props {
	id?: string;
}

const { id = 'site-menu' } = Astro.props;
---

<div class="menu-shell" data-menu>
	<button
		class="menu-trigger"
		type="button"
		aria-label="Open navigation"
		aria-controls={id}
		aria-expanded="false"
		data-menu-trigger
	>
		<span></span>
		<span></span>
		<span></span>
	</button>

	<nav
		id={id}
		class="menu-panel"
		aria-label="Primary navigation"
		aria-hidden="true"
		data-menu-panel
		inert
	>
		<div class="menu-tree">
			<a class="menu-root" href="#home-details" aria-label="Go to Home details">
				<House class="menu-icon" size={22} stroke-width={1.5} aria-hidden="true" />
				<span>Home</span>
			</a>

			<div class="menu-branches">
				<ul>
					{
						menuItems.map((item) => (
							<li>
								<a
									href={item.href}
									target={item.external ? '_blank' : undefined}
									rel={item.external ? 'noreferrer' : undefined}
								>
									<Folder class="menu-icon" size={22} stroke-width={1.5} aria-hidden="true" />
									<span>{item.label}</span>
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</nav>
</div>

<script>
	const menus = document.querySelectorAll<HTMLElement>('[data-menu]');

	for (const menu of menus) {
		const trigger = menu.querySelector<HTMLButtonElement>('[data-menu-trigger]');
		const panel = menu.querySelector<HTMLElement>('[data-menu-panel]');

		if (!trigger || !panel) continue;
		const abortController = new AbortController();

		const setOpen = (open: boolean) => {
			menu.classList.toggle('is-open', open);
			trigger.setAttribute('aria-expanded', String(open));
			trigger.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
			panel.setAttribute('aria-hidden', String(!open));
			panel.inert = !open;
		};

		trigger.addEventListener(
			'click',
			() => {
				setOpen(trigger.getAttribute('aria-expanded') !== 'true');
			},
			{ signal: abortController.signal },
		);
		menu.addEventListener('menu:close', () => setOpen(false), {
			signal: abortController.signal,
		});

		panel.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => setOpen(false), { signal: abortController.signal });
		});

		document.addEventListener(
			'click',
			(event) => {
				if (
					menu.classList.contains('is-open') &&
					event.target instanceof Node &&
					!menu.contains(event.target)
				) {
					setOpen(false);
				}
			},
			{ signal: abortController.signal },
		);

		document.addEventListener(
			'keydown',
			(event) => {
				if (event.key === 'Escape' && menu.classList.contains('is-open')) {
					setOpen(false);
					trigger.focus();
				}
			},
			{ signal: abortController.signal },
		);
		document.addEventListener('astro:before-swap', () => abortController.abort(), {
			once: true,
		});
	}
</script>

<style>
	.menu-shell {
		position: fixed;
		top: calc(var(--page-inset) + var(--control-offset));
		left: calc(var(--page-inset) + var(--control-offset));
		z-index: 40;
	}

	.menu-trigger {
		position: relative;
		z-index: 2;
		display: grid;
		width: 2.75rem;
		height: 2.75rem;
		padding: 0.8rem 0.7rem;
		align-content: space-between;
		border: 0;
		background: transparent;
		cursor: pointer;
		animation: detail-enter 550ms ease-out 450ms both;
	}

	.menu-trigger span {
		display: block;
		width: 1.35rem;
		height: 1px;
		background: var(--color-accent-muted);
		transform-origin: center;
		transition: background-color var(--duration-fast) ease,
			opacity var(--duration-fast) ease, transform 220ms ease;
	}

	.menu-trigger:hover span,
	.menu-trigger:focus-visible span,
	.is-open .menu-trigger span {
		background: var(--color-accent);
	}

	.menu-trigger:hover span:nth-child(2),
	.menu-trigger:focus-visible span:nth-child(2) {
		transform: translateX(2px);
	}

	.menu-trigger:focus-visible {
		outline: var(--border-width) solid var(--color-accent-muted);
		outline-offset: 4px;
	}

	.menu-trigger:active {
		transform: scale(0.97);
	}

	.is-open .menu-trigger span:first-child {
		transform: translateY(7px) rotate(45deg);
	}

	.is-open .menu-trigger span:nth-child(2) {
		opacity: 0;
		transform: scaleX(0.25);
	}

	.is-open .menu-trigger span:last-child {
		transform: translateY(-7px) rotate(-45deg);
	}

	.menu-panel {
		position: absolute;
		top: -0.75rem;
		left: -0.75rem;
		width: min(17rem, calc(100vw - 3.5rem));
		max-height: calc(100dvh - 2 * (var(--page-inset) + var(--control-offset)));
		padding: 1.1rem 1.35rem 1.4rem;
		overflow-y: auto;
		scrollbar-width: thin;
		scrollbar-color: var(--color-accent-muted) transparent;
		visibility: hidden;
		border: var(--border-width) solid var(--color-border);
		border-radius: var(--radius-small);
		background: var(--color-surface-raised);
		opacity: 0;
		transform: translateX(-12px);
		transition: opacity 200ms ease, transform 280ms var(--ease-out),
			visibility 0s linear 280ms;
	}

	.is-open .menu-panel {
		visibility: visible;
		opacity: 1;
		transform: translateX(0);
		transition-delay: 0s;
	}

	.menu-tree {
		display: grid;
		margin-top: 2.35rem;
	}

	.menu-root {
		display: grid;
		min-height: 2.5rem;
		grid-template-columns: 1.35rem minmax(0, 1fr);
		align-items: center;
		gap: 0.65rem;
		color: var(--color-accent);
		font-size: 1.05rem;
		letter-spacing: 0.035em;
		text-decoration: none;
		transition: color var(--duration-fast) ease, transform var(--duration-fast) ease;
	}

	.menu-root:hover,
	.menu-root:focus-visible {
		color: var(--color-text);
		transform: translateX(3px);
	}

	.menu-root:focus-visible {
		outline: var(--border-width) solid var(--color-accent-muted);
		outline-offset: 3px;
	}

	.menu-branches {
		position: relative;
		padding-left: 1.8rem;
	}

	.menu-branches::before {
		position: absolute;
		top: 0;
		bottom: 1.35rem;
		left: 0.67rem;
		border-left: 1px dotted var(--color-accent-muted);
		content: '';
		opacity: 0.82;
	}

	.menu-panel ul {
		position: relative;
		display: grid;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.menu-panel li {
		position: relative;
		min-height: 2.65rem;
		opacity: 0;
		transform: translateY(5px);
		transition: opacity 180ms ease, transform 220ms ease;
	}

	.menu-panel li::before {
		position: absolute;
		top: 50%;
		left: -1.13rem;
		width: 0.95rem;
		border-top: 1px dotted var(--color-accent-muted);
		content: '';
		opacity: 0.78;
	}

	.is-open .menu-panel li {
		opacity: 1;
		transform: translateY(0);
	}

	.is-open .menu-panel li:nth-child(1) {
		transition-delay: 90ms;
	}

	.is-open .menu-panel li:nth-child(2) {
		transition-delay: 120ms;
	}

	.is-open .menu-panel li:nth-child(3) {
		transition-delay: 150ms;
	}

	.is-open .menu-panel li:nth-child(4) {
		transition-delay: 180ms;
	}

	.is-open .menu-panel li:nth-child(5) {
		transition-delay: 210ms;
	}

	:global(.menu-icon) {
		width: 1.35rem;
		height: auto;
		color: var(--color-text-muted);
		transition: color var(--duration-fast) ease;
	}

	.menu-root :global(.menu-icon) {
		color: var(--color-accent);
	}

	.menu-root:hover :global(.menu-icon),
	.menu-root:focus-visible :global(.menu-icon) {
		color: var(--color-text);
	}

	.menu-panel li > a {
		display: grid;
		min-height: 2.65rem;
		grid-template-columns: 1.35rem minmax(0, 1fr);
		align-items: center;
		align-self: stretch;
		gap: 0.6rem;
		color: var(--color-text-muted);
		font-size: 1.05rem;
		letter-spacing: 0.035em;
		text-decoration: none;
		transition: color var(--duration-fast) ease, transform var(--duration-fast) ease;
	}

	.menu-panel li > a:hover,
	.menu-panel li > a:focus-visible {
		color: var(--color-text);
		transform: translateX(3px);
	}

	.menu-panel li > a:hover :global(.menu-icon),
	.menu-panel li > a:focus-visible :global(.menu-icon) {
		color: var(--color-accent);
	}

	.menu-panel li > a:focus-visible {
		outline: var(--border-width) solid var(--color-accent-muted);
		outline-offset: 3px;
	}

	@keyframes detail-enter {
		from {
			opacity: 0;
			transform: translateY(4px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.menu-shell,
		.menu-trigger span,
		.menu-panel,
		.menu-panel li,
		.menu-panel a,
		:global(.menu-icon) {
			animation: none;
			transition-duration: 0.01ms;
		}
	}
</style>
