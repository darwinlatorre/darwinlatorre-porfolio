---
import { profile } from '../../data/portfolio';

const links = [
	{ label: 'GitHub', href: 'https://github.com/darwinlatorre', external: true },
	{ label: 'LinkedIn', href: 'https://www.linkedin.com/in/darwinlatorre/', external: true },
	{ label: 'Email', href: `mailto:${profile.email}`, external: false },
];
---

<footer class="site-footer" id="site-footer" aria-label="Site footer">
	<div class="footer-inner">
		<p class="footer-copy">© 2026 <span class="footer-name">Darwinlatorre_</span></p>
		<nav class="footer-links" aria-label="Footer links">
			{
				links.map(({ label, href, external }, index) => (
					<>
						{index > 0 && (
							<span class="footer-sep" aria-hidden="true">
								•
							</span>
						)}
						<a href={href} target={external ? '_blank' : undefined} rel={external ? 'noreferrer' : undefined}>
							{label}
						</a>
					</>
				))
			}
		</nav>
		<p class="footer-tags">Built with Java <span aria-hidden="true">•</span> Cloud <span aria-hidden="true">•</span> DevOps</p>
	</div>
</footer>

<style>
	.site-footer {
		--footer-gutter: var(--content-gutter);
		--footer-tuck: calc(var(--page-inset) + 3.25rem);
		flex: none;
		scroll-snap-align: end;
		background: var(--color-surface);
	}

	.footer-inner {
		position: relative;
		display: flex;
		width: min(var(--content-max-width), 100%);
		margin: 0 auto;
		padding: 1.1rem var(--footer-gutter) calc(var(--page-inset) + 1.1rem);
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.65rem 1.5rem;
		font-size: 0.75rem;
		letter-spacing: 0.02em;
		line-height: 1.4;
	}

	.footer-inner::before {
		content: '';
		position: absolute;
		top: 0;
		left: var(--footer-gutter);
		right: var(--footer-gutter);
		border-top: var(--border-width) solid var(--color-border);
	}

	.footer-copy,
	.footer-tags {
		margin: 0;
		color: var(--color-text-muted);
	}

	.footer-name {
		color: var(--color-accent);
	}

	.footer-links {
		display: flex;
		align-items: center;
		gap: 0.7rem;
	}

	.footer-links a {
		color: var(--color-text);
		text-decoration: none;
		transition: color var(--duration-fast) ease;
	}

	.footer-links a:hover,
	.footer-links a:focus-visible {
		color: var(--color-accent);
	}

	.footer-links a:focus-visible {
		outline: 1px solid var(--color-accent-muted);
		outline-offset: 3px;
	}

	.footer-sep {
		color: var(--color-accent-muted);
	}

	@media (min-width: 48rem) {
		.site-footer {
			margin-top: calc(-1 * var(--footer-tuck));
		}
	}

	@media (max-width: 48rem) {
		.footer-inner {
			justify-content: center;
			flex-direction: column;
			text-align: center;
		}
	}

	@media (hover: none), (pointer: coarse) {
		.footer-links a:hover {
			color: var(--color-text);
		}
	}
</style>
