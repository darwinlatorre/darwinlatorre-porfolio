---
import { Palette } from '@lucide/astro';
import { themes } from '../../data/themes';

interface Props {
	/** `floating` is the desktop corner control; `inline` sits inside the mobile drawer. */
	variant?: 'floating' | 'inline';
}

const { variant = 'floating' } = Astro.props;
const floating = variant === 'floating';
const panelId = `theme-options-${variant}`;
---

<div class:list={['theme-switcher', `is-${variant}`]} data-theme-switcher>
	{floating ? (
		<button
			class="theme-trigger"
			type="button"
			aria-label="Change theme"
			aria-controls={panelId}
			aria-expanded="false"
			data-theme-trigger
		>
			<Palette size={18} stroke-width={1.5} aria-hidden="true" />
		</button>
	) : (
		<p class="theme-command" aria-hidden="true"><span>$</span> theme</p>
	)}

	<div
		id={panelId}
		class="theme-options"
		role="group"
		aria-label="Color theme"
		inert={floating}
		data-theme-options
	>
		{
			themes.map(({ id, label, accent, background }) => (
				<button
					class="theme-option"
					type="button"
					aria-pressed={id === 'violet' ? 'true' : 'false'}
					data-theme-option={id}
					style={`--swatch-accent: ${accent}; --swatch-background: ${background};`}
				>
					<span class="theme-swatch" aria-hidden="true"></span>
					<span>{label}</span>
				</button>
			))
		}
	</div>
</div>

<style>
	.theme-option {
		display: inline-flex;
		min-height: 2.75rem;
		padding: 0 0.75rem;
		align-items: center;
		gap: 0.6rem;
		border: 1px solid transparent;
		border-radius: var(--radius-small);
		background: transparent;
		color: var(--color-text-secondary);
		font-size: 0.85rem;
		cursor: pointer;
		transition: color var(--duration-fast) ease, border-color var(--duration-fast) ease;
	}

	.theme-option:hover {
		color: var(--color-text);
	}

	.theme-option[aria-pressed='true'] {
		border-color: var(--color-border);
		color: var(--color-text);
	}

	.theme-option:focus-visible,
	.theme-trigger:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 2px;
	}

	/* Each swatch previews the theme: its background with its accent as a dot. */
	.theme-swatch {
		display: grid;
		width: 1.1rem;
		height: 1.1rem;
		flex: 0 0 auto;
		place-items: center;
		border: 1px solid color-mix(in srgb, var(--swatch-accent) 45%, transparent);
		border-radius: 50%;
		background: var(--swatch-background);
	}

	.theme-swatch::after {
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 50%;
		background: var(--swatch-accent);
		content: '';
	}

	/* Desktop corner control, mirroring the menu button on the left. */
	.is-floating {
		position: fixed;
		top: calc(var(--page-inset) + var(--control-offset));
		right: calc(var(--page-inset) + var(--control-offset));
		z-index: 40;
	}

	.theme-trigger {
		display: grid;
		width: 2.75rem;
		height: 2.75rem;
		padding: 0;
		place-items: center;
		border: 0;
		background: transparent;
		color: var(--color-text-muted);
		cursor: pointer;
		transition: color var(--duration-fast) ease;
	}

	.theme-trigger:hover,
	.is-open .theme-trigger {
		color: var(--color-accent);
	}

	.is-floating .theme-options {
		position: absolute;
		top: calc(100% + 0.4rem);
		right: 0;
		display: grid;
		min-width: 10rem;
		padding: 0.4rem;
		gap: 0.15rem;
		border: var(--border-width) solid var(--color-border);
		border-radius: var(--radius-small);
		background: var(--color-surface-raised);
		opacity: 0;
		pointer-events: none;
		transform: translateY(-4px);
		transition: opacity 160ms ease, transform 200ms var(--ease-out);
	}

	.is-floating.is-open .theme-options {
		opacity: 1;
		pointer-events: auto;
		transform: none;
	}

	.is-floating .theme-option {
		justify-content: flex-start;
	}

	/* Drawer version: a terminal prompt line over three options in a row. */
	.is-inline {
		display: grid;
		gap: 0.6rem;
	}

	.theme-command {
		margin: 0;
		color: var(--color-text-secondary);
		font-size: 0.8rem;
	}

	.theme-command span {
		color: var(--color-accent);
	}

	.is-inline .theme-options {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.4rem;
	}

	.is-inline .theme-option {
		justify-content: center;
		padding-inline: 0.4rem;
	}

	@media (max-width: 48rem) {
		.is-floating {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.theme-option,
		.theme-trigger,
		.is-floating .theme-options {
			transition: none;
		}
	}
</style>

<script>
	import '../../scripts/theme';
</script>
