---
import type { TerminalContext } from '../../types/terminal';

interface Props {
	context: TerminalContext;
	responseId: string;
}

const { context, responseId } = Astro.props;
const inputId = `${context}-terminal-command`;
---

<section class="terminal-prompt" data-terminal-root data-terminal-context={context}>
	<form class="command-form" data-terminal-form>
		<label class="command-line" for={inputId}>
			<span class="prompt">
				$
			</span>
			<span class="terminal-input-shell">
				<input
					id={inputId}
					name="command"
					type="text"
					placeholder="help"
					autocomplete="off"
					spellcheck="false"
					enterkeyhint="send"
					aria-describedby={responseId}
					aria-label={`Command for ${context} terminal`}
					data-terminal-input
				/>
				<span class="cursor-track" aria-hidden="true">
					<span class="input-mirror" data-terminal-mirror></span>
					<span class="terminal-cursor">_</span>
				</span>
			</span>
		</label>
	</form>
	<div
		id={responseId}
		class="terminal-response"
		role="status"
		aria-live="polite"
		aria-atomic="true"
		data-terminal-response
		hidden
	></div>
</section>

<style>
	.terminal-prompt {
		display: grid;
		width: 100%;
		min-height: 1.7rem;
		gap: 0.45rem;
	}

	.command-form {
		margin: 0;
	}

	.command-line {
		display: flex;
		width: 100%;
		margin: 0;
		align-items: baseline;
		gap: 0.65rem;
		color: var(--color-text);
		font-size: var(--terminal-font-size);
		letter-spacing: 0.01em;
		line-height: 1.45;
	}

	.prompt {
		display: inline-flex;
		flex: 0 0 auto;
		color: var(--color-accent);
	}

	.terminal-input-shell {
		position: relative;
		display: block;
		width: min(32rem, 100%);
		min-width: 4rem;
		flex: 1 1 auto;
		overflow: hidden;
	}

	input {
		position: relative;
		z-index: 1;
		display: block;
		width: 100%;
		min-width: 0;
		padding: 0;
		border: 0;
		outline: 0;
		background: transparent;
		caret-color: transparent;
		color: var(--color-text);
		font: inherit;
		letter-spacing: inherit;
		line-height: inherit;
	}

	input::placeholder {
		color: color-mix(in srgb, var(--color-text-muted) 68%, transparent);
		opacity: 1;
	}

	input:focus {
		caret-color: var(--color-accent);
	}

	.terminal-input-shell:focus-within .cursor-track {
		visibility: hidden;
	}

	.cursor-track {
		position: absolute;
		z-index: 2;
		inset: 0;
		display: flex;
		align-items: baseline;
		overflow: hidden;
		font: inherit;
		line-height: inherit;
		pointer-events: none;
	}

	.input-mirror {
		visibility: hidden;
		flex: 0 0 auto;
		white-space: pre;
	}

	.terminal-cursor {
		flex: 0 0 auto;
		color: var(--color-accent);
		animation: terminal-cursor-blink 1.1s step-end infinite;
	}

	.terminal-response {
		display: grid;
		margin: 0;
		padding: 0.35rem 0 0.35rem 1.35rem;
		border-left: 1px solid var(--color-accent-muted);
		gap: 0.45rem;
		color: var(--color-text-muted);
		font-size: var(--terminal-font-size);
		line-height: 1.45;
	}

	.terminal-response[hidden] {
		display: none;
	}

	.terminal-response :global(p),
	.terminal-response :global(ul) {
		margin: 0;
	}

	.terminal-response :global(ul) {
		display: grid;
		padding-left: 1.15rem;
		gap: 0.25rem;
	}

	.terminal-response :global(a) {
		width: fit-content;
		color: var(--color-accent);
		text-underline-offset: 0.2em;
	}

	.terminal-response :global(a:focus-visible) {
		outline: 1px solid var(--color-accent-muted);
		outline-offset: 3px;
	}

	@keyframes terminal-cursor-blink {
		0%,
		48% {
			opacity: 1;
		}

		49%,
		100% {
			opacity: 0.12;
		}
	}

	@media (max-width: 48rem) {
		.command-line {
			flex-wrap: wrap;
			gap: 0.2rem 0.55rem;
		}

		.terminal-input-shell {
			width: auto;
			flex-basis: 0;
			font-size: 1rem;
		}

		input {
			font-size: inherit;
			appearance: none;
			border-radius: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.terminal-cursor {
			animation: none;
		}
	}
</style>
