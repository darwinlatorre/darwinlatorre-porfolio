---
import TreeIcon from './TreeIcon.astro';

const projectItems = ['Proyecto 1', 'Proyecto 2', 'Proyecto 3'];
const certificateItems = ['Proyecto 1', 'Proyecto 2', 'Proyecto 3'];
---

<nav class="file-tree" aria-label="Portfolio sections">
	<a class="tree-row is-active" href="#home" aria-current="page">
		<TreeIcon type="home" />
		<span>Home</span>
	</a>

	<a class="tree-row" href="#about">
		<TreeIcon type="folder" />
		<span>About</span>
	</a>

	<div class="tree-group" data-tree-group>
		<button
			class="tree-row tree-toggle"
			type="button"
			aria-expanded="true"
			aria-controls="projects-tree"
			data-tree-toggle
		>
			<TreeIcon type="folder" />
			<span>Projects</span>
			<svg class="chevron" viewBox="0 0 16 16" aria-hidden="true">
				<path d="m4 6 4 4 4-4"></path>
			</svg>
		</button>

		<div id="projects-tree" class="tree-children">
			<div class="tree-children-inner">
				{
					projectItems.map((item, index) => (
						<a href={`#project-${index + 1}`}>
							<TreeIcon type="file" />
							<span>{item}</span>
						</a>
					))
				}
			</div>
		</div>
	</div>

	<a class="tree-row" href="#experience">
		<TreeIcon type="folder" />
		<span>Experience</span>
	</a>

	<a class="tree-row" href="#services">
		<TreeIcon type="folder" />
		<span>Services</span>
	</a>

	<div class="tree-group" data-tree-group>
		<button
			class="tree-row tree-toggle"
			type="button"
			aria-expanded="true"
			aria-controls="certificates-tree"
			data-tree-toggle
		>
			<TreeIcon type="folder" />
			<span>Certificates</span>
			<svg class="chevron" viewBox="0 0 16 16" aria-hidden="true">
				<path d="m4 6 4 4 4-4"></path>
			</svg>
		</button>

		<div id="certificates-tree" class="tree-children">
			<div class="tree-children-inner">
				{
					certificateItems.map((item, index) => (
						<a href={`#certificate-${index + 1}`}>
							<TreeIcon type="file" />
							<span>{item}</span>
						</a>
					))
				}
			</div>
		</div>
	</div>
</nav>

<script>
	const treeGroups = document.querySelectorAll<HTMLElement>('[data-tree-group]');

	for (const group of treeGroups) {
		const toggle = group.querySelector<HTMLButtonElement>('[data-tree-toggle]');

		if (!toggle) continue;

		toggle.addEventListener('click', () => {
			const expanded = toggle.getAttribute('aria-expanded') === 'true';
			toggle.setAttribute('aria-expanded', String(!expanded));
			group.classList.toggle('is-collapsed', expanded);
		});
	}
</script>

<style>
	.file-tree {
		display: grid;
		width: min(21rem, 100%);
		align-content: center;
		font-size: 0.86rem;
	}

	.tree-row {
		display: grid;
		width: 100%;
		min-height: 2.25rem;
		padding: 0 0.2rem;
		grid-template-columns: 1.15rem minmax(0, 1fr) auto;
		align-items: center;
		gap: 0.55rem;
		border: 0;
		background: transparent;
		color: var(--color-text-muted);
		font: inherit;
		letter-spacing: 0.02em;
		text-align: left;
		text-decoration: none;
		transition: color var(--duration-fast) ease, transform var(--duration-fast) ease;
	}

	button.tree-row {
		cursor: pointer;
	}

	.tree-row:hover,
	.tree-row:focus-visible {
		color: var(--color-text);
		transform: translateX(2px);
	}

	.tree-row:focus-visible,
	.tree-children a:focus-visible {
		outline: 1px solid var(--color-accent-muted);
		outline-offset: 2px;
	}

	.tree-row.is-active {
		color: var(--color-accent);
	}

	.chevron {
		width: 0.8rem;
		height: 0.8rem;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.5;
		transition: transform 220ms ease;
	}

	.tree-group.is-collapsed .chevron {
		transform: rotate(-90deg);
	}

	.tree-children {
		display: grid;
		grid-template-rows: 1fr;
		opacity: 1;
		transition: grid-template-rows 260ms var(--ease-out), opacity 180ms ease;
	}

	.tree-group.is-collapsed .tree-children {
		grid-template-rows: 0fr;
		opacity: 0;
	}

	.tree-children-inner {
		position: relative;
		display: grid;
		min-height: 0;
		margin-left: 0.72rem;
		padding-left: 1.9rem;
		overflow: hidden;
	}

	.tree-children-inner::before {
		position: absolute;
		top: 0;
		bottom: 1rem;
		left: 0.38rem;
		border-left: 1px dotted color-mix(in srgb, var(--color-accent-muted) 65%, transparent);
		content: '';
	}

	.tree-children a {
		position: relative;
		display: grid;
		min-height: 1.9rem;
		grid-template-columns: 1rem minmax(0, 1fr);
		align-items: center;
		gap: 0.5rem;
		color: var(--color-text-muted);
		font-size: 0.76rem;
		text-decoration: none;
		transition: color var(--duration-fast) ease, transform var(--duration-fast) ease;
	}

	.tree-children a::before {
		position: absolute;
		top: 50%;
		left: -1.5rem;
		width: 1.1rem;
		border-top: 1px dotted color-mix(in srgb, var(--color-accent-muted) 65%, transparent);
		content: '';
	}

	.tree-children a :global(.tree-icon) {
		color: var(--color-accent-muted);
	}

	.tree-children a:hover,
	.tree-children a:focus-visible {
		color: var(--color-text);
		transform: translateX(2px);
	}

	@media (max-width: 48rem) {
		.file-tree {
			width: min(22rem, 100%);
			font-size: 0.78rem;
		}

		.tree-row {
			min-height: 1.95rem;
		}

		.tree-children a {
			min-height: 1.6rem;
			font-size: 0.7rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.tree-row,
		.chevron,
		.tree-children,
		.tree-children a {
			transition: none;
		}
	}
</style>
