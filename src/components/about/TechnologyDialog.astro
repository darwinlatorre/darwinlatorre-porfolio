---
import { X } from '@lucide/astro';
import {
	siAngular,
	siDocker,
	siGithubactions,
	siGooglecloud,
	siGrafana,
	siHelm,
	siKubernetes,
	siMongodb,
	siPrometheus,
	siRedis,
	siSonarqubeserver,
	siSpring,
	siTerraform,
	siVault,
} from 'simple-icons';

const technologies = [
	{
		label: 'AWS',
		src: 'https://cdn.jsdelivr.net/gh/devicons/devicon@v2.17.0/icons/amazonwebservices/amazonwebservices-plain-wordmark.svg',
		wide: true,
	},
	{ label: 'Kubernetes', icon: siKubernetes },
	{ label: 'Terraform', icon: siTerraform },
	{ label: 'Docker', icon: siDocker },
	{ label: 'Helm', icon: siHelm },
	{
		label: 'Jenkins',
		src: 'https://cdn.jsdelivr.net/gh/devicons/devicon@v2.17.0/icons/jenkins/jenkins-original.svg',
	},
	{ label: 'GitHub Actions', icon: siGithubactions },
	{ label: 'Prometheus', icon: siPrometheus },
	{ label: 'Grafana', icon: siGrafana },
	{ label: 'Vault', icon: siVault, color: '#f5f2f7' },
	{ label: 'GCP', icon: siGooglecloud },
	{ label: 'SonarQube', icon: siSonarqubeserver },
	{ label: 'Redis', icon: siRedis },
	{ label: 'MongoDB', icon: siMongodb },
	{ label: 'Spring', icon: siSpring },
	{ label: 'Angular', icon: siAngular, color: '#dd0031' },
];
---

<dialog class="technology-dialog" aria-labelledby="technologies-title" data-technologies-dialog>
	<div class="technology-window">
		<header class="technology-header">
			<h2 id="technologies-title"><span aria-hidden="true">&gt;</span> Technologies</h2>
			<button type="button" aria-label="Close technologies" data-technologies-close>
				<X size={24} stroke-width={1.35} aria-hidden="true" />
			</button>
		</header>

		<p class="technology-summary">
			<span aria-hidden="true">&gt;</span> 16+ technologies I've worked with
		</p>

		<ul class="technology-grid" aria-label="Technology list">
			{
				technologies.map(({ label, icon, src, color, wide }) => (
					<li title={label}>
						{src ? (
							<img
								class:list={['technology-image', { 'is-wide': wide }]}
								src={src}
								alt=""
								width="128"
								height="128"
								loading="lazy"
								decoding="async"
							/>
						) : icon ? (
							<svg
								class="technology-icon"
								viewBox="0 0 24 24"
								style={`--technology-color: ${color ?? `#${icon.hex}`}`}
								aria-hidden="true"
							>
								<path d={icon.path} />
							</svg>
						) : null}
						<span>{label}</span>
					</li>
				))
			}
		</ul>

		<footer class="technology-footer">
			<p><span aria-hidden="true">&gt;</span> Built, deployed and scaled with these tools.</p>
		</footer>
	</div>
</dialog>

<style>
	.technology-dialog {
		width: min(62rem, calc(100vw - 2rem));
		max-width: none;
		max-height: min(82dvh, 43rem);
		margin: auto;
		padding: 0;
		overflow: hidden;
		border: 1px solid var(--color-accent-muted);
		border-radius: var(--radius-frame);
		background: color-mix(in srgb, var(--color-surface-raised) 96%, transparent);
		box-shadow: 0 1.5rem 5rem rgb(0 0 0 / 48%);
		color: var(--color-text);
		overscroll-behavior: contain;
	}

	.technology-dialog::backdrop {
		background: rgb(6 5 9 / 78%);
		backdrop-filter: blur(3px);
	}

	.technology-dialog[open] {
		animation: dialog-enter 220ms var(--ease-out) both;
	}

	.technology-window {
		display: grid;
		max-height: inherit;
		padding: clamp(1.35rem, 3vw, 2.25rem);
		overflow-y: auto;
		gap: clamp(1.5rem, 3.5vh, 2.5rem);
		scrollbar-width: thin;
		scrollbar-color: var(--color-accent-muted) transparent;
		overscroll-behavior: contain;
	}

	.technology-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.technology-header h2,
	.technology-summary,
	.technology-footer p {
		margin: 0;
		font-weight: 400;
		letter-spacing: 0.015em;
	}

	.technology-header h2 {
		font-size: clamp(1rem, 1.8vw, 1.3rem);
	}

	.technology-header h2 span,
	.technology-summary span,
	.technology-footer p span {
		color: var(--color-accent);
	}

	.technology-header button {
		display: grid;
		width: 2.75rem;
		height: 2.75rem;
		padding: 0;
		place-items: center;
		border: 0;
		background: transparent;
		color: var(--color-text-muted);
		cursor: pointer;
		transition: color var(--duration-fast) ease, transform var(--duration-fast) ease;
	}

	.technology-header button:hover,
	.technology-header button:focus-visible {
		color: var(--color-accent);
		transform: rotate(90deg);
	}

	.technology-header button:focus-visible {
		outline: 1px solid var(--color-accent-muted);
		outline-offset: 2px;
	}

	.technology-summary {
		color: var(--color-text-muted);
		font-size: clamp(0.8rem, 1.25vw, 0.95rem);
	}

	.technology-grid {
		display: grid;
		margin: 0;
		padding: 0;
		grid-template-columns: repeat(8, minmax(0, 1fr));
		gap: clamp(1.25rem, 3vw, 2.25rem) 1rem;
		list-style: none;
	}

	.technology-grid li {
		display: grid;
		min-width: 0;
		justify-items: center;
		gap: 0.65rem;
		color: var(--color-text-muted);
		text-align: center;
		transition: color 180ms ease, transform 220ms var(--ease-out);
	}

	.technology-grid li:hover {
		color: var(--color-accent);
		transform: translateY(-3px);
	}

	.technology-icon,
	.technology-image {
		width: clamp(1.8rem, 3vw, 2.5rem);
		height: clamp(1.8rem, 3vw, 2.5rem);
		object-fit: contain;
	}

	.technology-icon {
		color: var(--technology-color);
		fill: currentColor;
		filter: drop-shadow(0 0 5px color-mix(in srgb, var(--technology-color) 18%, transparent));
	}

	.technology-image {
		filter: drop-shadow(0 0 5px rgb(169 110 211 / 12%));
	}

	.technology-image.is-wide {
		width: clamp(3.25rem, 5vw, 4.5rem);
	}

	.technology-grid li > span:last-child {
		max-width: 100%;
		overflow: hidden;
		font-size: 0.78rem;
		letter-spacing: 0.015em;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.technology-footer {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 1rem;
		color: var(--color-text-muted);
		font-size: clamp(0.72rem, 1.1vw, 0.85rem);
	}

	@keyframes dialog-enter {
		from {
			opacity: 0;
			transform: translateY(8px) scale(0.985);
		}
		to {
			opacity: 1;
			transform: translateY(0) scale(1);
		}
	}

	@media (max-width: 48rem) {
		.technology-dialog {
			width: calc(100vw - 1.25rem);
			max-height: 86dvh;
		}

		.technology-window {
			padding: 1.25rem;
			gap: 1.35rem;
		}

		.technology-grid {
			grid-template-columns: repeat(4, minmax(0, 1fr));
			gap: 1.35rem 0.75rem;
		}

		.technology-icon,
		.technology-image {
			width: 1.8rem;
			height: 1.8rem;
		}

		.technology-image.is-wide {
			width: 3.25rem;
		}

		.technology-footer {
			align-items: start;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.technology-dialog[open] {
			animation: none;
		}

		.technology-header button,
		.technology-grid li {
			transition: none;
		}
	}
</style>
