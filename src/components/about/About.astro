---
import { siGithub, siX } from 'simple-icons';
import TechnologyDialog from './TechnologyDialog.astro';

const socialLinks = [
	{
		label: 'LinkedIn',
		href: 'https://www.linkedin.com/in/darwinlatorre/',
		mark: 'in',
	},
	{
		label: 'GitHub',
		href: 'https://github.com/darwinlatorre',
		icon: siGithub,
	},
	{
		label: 'X',
		href: 'https://x.com/latorre_darwin',
		icon: siX,
	},
];

---

<section id="about" class="screen about" aria-label="About" data-about>
	<div
		class="about-content"
		tabindex="0"
		aria-label="About terminal content"
		data-about-content
	>
		<div class="terminal-layout">
			<section class="terminal-block">
				<p class="command-line" data-about-marker>
					<span class="prompt">
						<span>user@</span><span class="prompt-host">darwinlatorre:</span><span>~$</span>
					</span>
					<code>cd about &amp;&amp; cat resume.md</code>
				</p>

				<div class="command-output description-output" data-about-description>
					<span class="output-rule" aria-hidden="true" data-about-line></span>
					<p>
						I'm a DevOps and Backend Engineer focused on building reliable cloud infrastructure and
						scalable applications. My experience spans AWS, Kubernetes, Terraform, CI/CD, and Spring
						Boot, bridging development and operations to deliver efficient production systems.
					</p>
				</div>
			</section>

			<section class="terminal-block">
				<p class="command-line" data-about-stat-command>
					<span class="prompt">
						<span>user@</span><span class="prompt-host">darwinlatorre:</span><span>~$</span>
					</span>
					<code>tail -n 2 resume.md</code>
				</p>

				<div class="command-output stats-output">
					<div class="stat-row" data-about-stat-value>
						<span>experience_years:</span>
						<strong>3+</strong>
					</div>
					<button
						class="stat-row stat-trigger"
						type="button"
						aria-haspopup="dialog"
						data-technologies-open
						data-about-stat-value
					>
						<span>technologies_used:</span>
						<strong>16+</strong>
					</button>
				</div>
			</section>

			<section class="terminal-block links-block">
				<p class="command-line" data-about-social-command>
					<span class="prompt">
						<span>user@</span><span class="prompt-host">darwinlatorre:</span><span>~$</span>
					</span>
					<code>grep "links" resume.md</code>
				</p>

				<nav class="command-output social-links" aria-label="Social profiles">
					{
						socialLinks.map(({ label, href, icon, mark }) => (
							<a
								href={href}
								target="_blank"
								rel="noreferrer"
								aria-label={label}
								data-about-social
							>
								<span class="social-diamond" aria-hidden="true">
									{icon ? (
										<svg class="brand-icon" viewBox="0 0 24 24">
											<path d={icon.path} />
										</svg>
									) : (
										<span class="social-mark">{mark}</span>
									)}
								</span>
								<span class="social-name">{label}</span>
							</a>
						))
					}
				</nav>
			</section>

			<section class="terminal-block interactive-block" data-about-terminal-command>
				<form class="command-form" data-terminal-form>
					<label class="command-line" for="about-command">
						<span class="prompt">
							<span>user@</span><span class="prompt-host">darwinlatorre:</span><span>~$</span>
						</span>
						<span class="terminal-input-shell">
							<input
								id="about-command"
								name="command"
								type="text"
								placeholder="show"
								autocomplete="off"
								spellcheck="false"
								enterkeyhint="send"
								aria-describedby="terminal-response"
								data-terminal-input
							/>
							<span class="cursor-track" aria-hidden="true">
								<span class="input-mirror" data-terminal-mirror></span>
								<span class="input-cursor">_</span>
							</span>
						</span>
					</label>
				</form>
				<p
					id="terminal-response"
					class="terminal-response"
					role="status"
					aria-live="polite"
					data-terminal-response
					hidden
				></p>
			</section>
		</div>
	</div>

	<TechnologyDialog />
</section>

<style>
	.about {
		--about-header-space: calc(var(--page-inset) + var(--control-offset) + 3.75rem);
		--about-footer-space: calc(var(--page-inset) + var(--control-offset) + 2.75rem);

		display: grid;
		overflow: hidden;
		grid-template-rows: var(--about-header-space) minmax(0, 1fr) var(--about-footer-space);
	}

	.about-content {
		display: grid;
		width: min(80rem, 100%);
		height: 100%;
		min-height: 0;
		margin: 0 auto;
		padding: 0 clamp(2rem, 5vw, 4.5rem) 0.75rem;
		overflow-y: auto;
		grid-row: 2;
		align-items: safe center;
		scrollbar-width: none;
	}

	.about-content::-webkit-scrollbar {
		display: none;
	}

	.about-content.is-scroll-contained {
		overscroll-behavior-y: contain;
	}

	.terminal-layout {
		display: grid;
		width: 100%;
		gap: clamp(1.8rem, 4vh, 3.25rem);
	}

	.terminal-block {
		display: grid;
		gap: clamp(1rem, 2.2vh, 1.55rem);
	}

	.command-line {
		display: flex;
		margin: 0;
		align-items: baseline;
		gap: 0.8rem;
		color: var(--color-text);
		font-size: clamp(0.9rem, 1.4vw, 1.2rem);
		letter-spacing: 0.015em;
		line-height: 1.4;
	}

	.command-line code {
		color: var(--color-text);
		font: inherit;
	}

	.prompt {
		display: inline-flex;
		flex: 0 0 auto;
		color: var(--color-accent);
	}

	.prompt .prompt-host {
		color: color-mix(in srgb, var(--color-text-muted) 65%, var(--color-text));
	}

	.command-output {
		position: relative;
		margin-left: clamp(3.5rem, 7vw, 5.5rem);
		padding-left: clamp(1.5rem, 3vw, 2.9rem);
		border-left: 1px solid var(--color-accent-muted);
	}

	.description-output {
		border-left: 0;
	}

	.output-rule {
		position: absolute;
		top: 0;
		bottom: 0;
		left: 0;
		width: 1px;
		background: var(--color-accent-muted);
		transform-origin: top;
	}

	.description-output p {
		width: min(64rem, 100%);
		margin: 0;
		color: color-mix(in srgb, var(--color-text) 92%, var(--color-text-muted));
		font-size: clamp(1rem, 1.55vw, 1.35rem);
		letter-spacing: -0.018em;
		line-height: 1.55;
	}

	.stats-output {
		display: grid;
		width: fit-content;
		gap: 0.45rem;
	}

	.stat-row {
		display: grid;
		grid-template-columns: auto auto;
		align-items: baseline;
		justify-content: start;
		gap: 0.9rem;
		color: var(--color-text);
		font-size: clamp(0.95rem, 1.35vw, 1.18rem);
		letter-spacing: 0.01em;
		line-height: 1.3;
	}

	.stat-row strong {
		font: inherit;
		font-weight: 400;
	}

	button.stat-row {
		padding: 0;
		border: 0;
		background: transparent;
		font-family: inherit;
		text-align: left;
		cursor: pointer;
		transition: color var(--duration-fast) ease, transform var(--duration-fast) ease;
	}

	button.stat-row:hover,
	button.stat-row:focus-visible {
		color: var(--color-accent);
		transform: translateX(3px);
	}

	button.stat-row:focus-visible {
		outline: 1px solid var(--color-accent-muted);
		outline-offset: 4px;
	}

	.social-links {
		display: grid;
		width: fit-content;
		gap: 1.55rem;
	}

	.social-links a {
		display: grid;
		grid-template-columns: 2.5rem auto;
		align-items: center;
		gap: 1rem;
		color: var(--color-text);
		text-decoration: none;
	}

	.social-diamond {
		display: grid;
		width: 2rem;
		aspect-ratio: 1;
		place-items: center;
		border: 1px solid var(--color-accent-muted);
		transform: rotate(45deg);
		transition: border-color 180ms ease, transform 220ms var(--ease-out);
	}

	.brand-icon,
	.social-mark {
		width: 0.95rem;
		height: 0.95rem;
		color: var(--color-text);
		fill: currentColor;
		transform: rotate(-45deg);
		transition: color 180ms ease;
	}

	.social-mark {
		display: grid;
		place-items: center;
		font-size: 0.72rem;
		font-weight: 500;
		letter-spacing: -0.08em;
		line-height: 1;
	}

	.social-name {
		font-size: clamp(0.9rem, 1.25vw, 1.08rem);
		letter-spacing: 0.01em;
	}

	.social-links a:hover .social-diamond,
	.social-links a:focus-visible .social-diamond {
		border-color: var(--color-accent);
		transform: translateY(-2px) rotate(45deg);
	}

	.social-links a:hover .brand-icon,
	.social-links a:focus-visible .brand-icon,
	.social-links a:hover .social-mark,
	.social-links a:focus-visible .social-mark,
	.social-links a:hover .social-name,
	.social-links a:focus-visible .social-name {
		color: color-mix(in srgb, var(--color-accent) 72%, var(--color-text));
	}

	.social-links a:focus-visible {
		outline: 1px solid var(--color-accent-muted);
		outline-offset: 4px;
	}

	.command-form {
		margin: 0;
	}

	.command-form .command-line {
		width: 100%;
	}

	.terminal-input-shell {
		position: relative;
		display: block;
		width: min(32rem, 100%);
		min-width: 4rem;
		flex: 1 1 auto;
		overflow: hidden;
	}

	.command-form input {
		position: relative;
		z-index: 1;
		display: block;
		width: 100%;
		min-width: 0;
		padding: 0;
		border: 0;
		outline: 0;
		background: transparent;
		caret-color: transparent;
		color: var(--color-text);
		font: inherit;
		letter-spacing: inherit;
		line-height: inherit;
	}

	.command-form input::placeholder {
		color: color-mix(in srgb, var(--color-text-muted) 68%, transparent);
		opacity: 1;
	}

	.cursor-track {
		position: absolute;
		z-index: 2;
		inset: 0;
		display: flex;
		align-items: baseline;
		overflow: hidden;
		font: inherit;
		line-height: inherit;
		pointer-events: none;
	}

	.input-mirror {
		visibility: hidden;
		flex: 0 0 auto;
		white-space: pre;
	}

	.input-cursor {
		flex: 0 0 auto;
		color: var(--color-accent);
		animation: input-cursor-blink 1.1s step-end infinite;
	}

	@keyframes input-cursor-blink {
		0%,
		48% {
			opacity: 1;
		}
		49%,
		100% {
			opacity: 0.12;
		}
	}

	.terminal-response {
		margin: 0 0 0 clamp(3.5rem, 7vw, 5.5rem);
		padding: 0.35rem 0 0.35rem clamp(1.5rem, 3vw, 2.9rem);
		border-left: 1px solid var(--color-accent-muted);
		color: var(--color-text-muted);
		font-size: clamp(0.82rem, 1.15vw, 1rem);
		line-height: 1.45;
	}

	@media (max-width: 48rem) {
		.about {
			--about-header-space: calc(var(--page-inset) + var(--control-offset) + 3rem);
			--about-footer-space: calc(var(--page-inset) + var(--control-offset) + 2.5rem);
		}

	.about-content {
		padding-inline: 2rem;
		align-items: start;
		overflow: hidden;
		scrollbar-width: initial;
	}

	.about-content::-webkit-scrollbar {
		display: initial;
	}

		.terminal-layout {
			padding-top: 0.5rem;
			gap: clamp(0.875rem, 3.5vh, 1.625rem);
		}

		.terminal-block {
			gap: 0.1rem;
		}

		.command-line {
			flex-wrap: wrap;
			gap: 0.25rem 0.65rem;
			font-size: clamp(0.72rem, 3.4vw, 0.9rem);
		}

		.command-output {
			margin-left: 0.6rem;
			padding-left: 1.15rem;
		}

		.description-output p {
			font-size: clamp(0.82rem, 3.8vw, 0.98rem);
			line-height: 1.5;
		}

		.stat-row {
			gap: 0.7rem;
			font-size: clamp(0.8rem, 3.6vw, 0.95rem);
		}

		.social-links {
			gap: 1.55rem;
		}

		.social-links a {
			grid-template-columns: 2.25rem auto;
			gap: 0.75rem;
		}

		.social-diamond {
			width: 1.8rem;
		}

		.command-form .command-line {
			flex-wrap: wrap;
		}

		.terminal-input-shell {
			width: 100%;
			flex-basis: 100%;
		}

		.command-form input {
			font-size: 1rem;
			scroll-margin-block: 35dvh;
		}

		.terminal-response {
			margin-left: 0.6rem;
			padding-left: 1.15rem;
			font-size: clamp(0.72rem, 3.2vw, 0.85rem);
		}

	}

	@media (max-height: 50rem) {
		.social-links {
			display: flex;
			gap: 2rem;
			width: fit-content;
		}

		.social-links a {
			grid-template-columns: auto;
			gap: 0;
		}

		.social-name {
			display: none;
		}
	}

	@media (max-width: 48rem) and (max-height: 42rem) {
		.about {
			--about-header-space: calc(var(--page-inset) + var(--control-offset) + 2.25rem);
			--about-footer-space: calc(var(--page-inset) + var(--control-offset) + 2rem);
		}

			.terminal-layout {
			gap: 1.1rem;
		}

		.terminal-block {
			gap: 0.55rem;
		}

		.description-output p {
			font-size: clamp(0.75rem, 3.3vw, 0.86rem);
			line-height: 1.4;
		}
	}

	@media (hover: none), (pointer: coarse) {
		.social-links a:hover .social-diamond {
			border-color: var(--color-accent-muted);
			transform: rotate(45deg);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.social-diamond,
		.brand-icon,
		.social-mark {
			transition: none;
		}

		.input-cursor {
			animation: none;
		}

	}
</style>
