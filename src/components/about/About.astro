---
import { siGithub } from 'simple-icons';
import { profile, socialLinks as portfolioSocialLinks } from '../../data/portfolio';

// simple-icons no longer ships LinkedIn, so its mark is kept inline.
const linkedinPath =
	'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z';

const socialLinks = portfolioSocialLinks.map((link) => ({
	...link,
	iconPath: link.label === 'GitHub' ? siGithub.path : linkedinPath,
}));

const descriptionParts = profile.description.split(
	/(DevOps and Backend Engineer|AWS, GCP, Kubernetes, Terraform, CI\/CD, and Spring Boot)/,
);
---

<section id="about" class="screen about" aria-label="About" data-about>
	<div class="about-content">
		<p class="command-line" data-about-marker>
			<span class="prompt">
				<span>darwinlatorre ~/about</span><span>$</span>
			</span>
			<code data-typed-command>cat resume.md</code>
		</p>

		<div class="about-body">
			<span class="output-rule" aria-hidden="true" data-about-line></span>

			<p class="about-bio" data-about-description>
				{descriptionParts.map((part, index) => index % 2 === 1 ? <strong>{part}</strong> : part)}
			</p>

			<div class="about-facts">
				<dl class="about-stats">
					<div class="stat" data-about-stat-value>
						<dt>experience_years:</dt>
						<dd>{profile.experienceYears}</dd>
					</div>
					<div class="stat" data-about-stat-value>
						<dt>technologies_used:</dt>
						<dd>
							<button
								class="stat-trigger"
								type="button"
								aria-haspopup="dialog"
								aria-label={`View the ${profile.technologiesUsed} technologies used`}
								title="View technologies"
								data-technologies-open
							>
								{profile.technologiesUsed}
							</button>
						</dd>
					</div>
				</dl>

				<nav class="social-links" aria-label="Social profiles">
					{
						socialLinks.map(({ label, href, iconPath }) => (
							<a
								href={href}
								target="_blank"
								rel="noreferrer"
								aria-label={label}
								title={label}
								data-about-social
							>
								<svg class="brand-icon" viewBox="0 0 24 24" aria-hidden="true">
									<path d={iconPath} />
								</svg>
							</a>
						))
					}
				</nav>
			</div>
		</div>
	</div>
</section>

<style>
	/*
	 * Reading order: prompt, then the bio as the lead, then one row of facts and links.
	 * Everything hangs from a single rail so the left edge matches the other sections.
	 */
	.about {
		--about-rail: 1.25rem;
		--about-measure: 46rem;

		display: grid;
		grid-template-rows: var(--section-space-start) auto var(--section-space-end);
	}

	.about-content {
		display: grid;
		width: min(var(--content-max-width), 100%);
		margin: 0 auto;
		padding-inline: var(--content-gutter);
		grid-row: 2;
		gap: clamp(1.75rem, 4vh, 2.75rem);
	}

	.command-line {
		display: flex;
		margin: 0;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 0.25rem 0.8rem;
		color: var(--color-text-secondary);
		font-size: var(--terminal-font-size);
		letter-spacing: 0.015em;
		line-height: 1.4;
	}

	.command-line code {
		color: inherit;
		font: inherit;
	}

	.prompt {
		display: inline-flex;
		flex: 0 0 auto;
		gap: 0.5em;
		color: var(--color-accent);
	}

	.about-body {
		position: relative;
		display: grid;
		max-width: calc(var(--about-measure) + var(--about-rail));
		padding-left: var(--about-rail);
		gap: clamp(1.5rem, 3.5vh, 2.25rem);
	}

	.output-rule {
		position: absolute;
		top: 0.35rem;
		bottom: 0.35rem;
		left: 0;
		width: 1px;
		background: var(--color-accent-muted);
		transform-origin: top;
	}

	/* The lead: larger, with the key phrases lifted out of the secondary tone. */
	.about-bio {
		margin: 0;
		color: var(--color-text-secondary);
		font-size: clamp(1.05rem, 1.5vw, 1.25rem);
		letter-spacing: 0;
		line-height: 1.65;
	}

	.about-bio strong {
		color: var(--color-text);
		font-weight: 600;
	}

	.about-facts {
		display: flex;
		padding-top: clamp(1rem, 2.5vh, 1.5rem);
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 1rem 2rem;
		border-top: 1px dashed var(--color-accent-muted);
	}

	.about-stats {
		display: flex;
		margin: 0;
		/* Baseline keeps both pairs on one text line despite the taller tap target. */
		align-items: baseline;
		flex-wrap: wrap;
		gap: 0.5rem 2.25rem;
	}

	.stat {
		display: flex;
		align-items: baseline;
		gap: 0.6rem;
	}

	.stat dt {
		color: var(--color-text-muted);
		font-size: 0.85rem;
	}

	.stat dd {
		margin: 0;
		color: var(--color-text);
		font-size: 1rem;
		font-weight: 600;
	}

	/* The count opens the technology list; the dotted underline marks it as actionable. */
	.stat-trigger {
		display: inline-flex;
		min-height: 2.75rem;
		padding: 0;
		align-items: center;
		border: 0;
		background: transparent;
		color: inherit;
		font: inherit;
		text-decoration: underline dotted;
		text-decoration-color: var(--color-accent);
		text-underline-offset: 0.3em;
		cursor: pointer;
		transition: color var(--duration-fast) ease;
	}

	.stat-trigger:hover,
	.stat-trigger:focus-visible {
		color: var(--color-accent);
	}

	.stat-trigger:focus-visible {
		outline: 2px solid var(--color-accent-muted);
		outline-offset: 3px;
	}

	.social-links {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-right: calc((2.75rem - 1.35rem) / -2);
	}

	.social-links a {
		display: grid;
		width: 2.75rem;
		height: 2.75rem;
		place-items: center;
		color: var(--color-text-secondary);
		text-decoration: none;
		transition: color 180ms ease, translate 220ms var(--ease-out);
	}

	.brand-icon {
		width: 1.35rem;
		height: 1.35rem;
		fill: currentColor;
	}

	.social-links a:hover,
	.social-links a:focus-visible {
		color: var(--color-accent);
		/* `translate`, not `transform`: the scroll reveal owns the inline transform. */
		translate: 0 -2px;
	}

	.social-links a:focus-visible {
		outline: 2px solid var(--color-accent-muted);
		outline-offset: 2px;
	}

	@media (max-width: 48rem) {
		.about {
			--about-rail: 1rem;
		}

		.about-content {
			gap: 1.5rem;
		}

		.about-facts {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.75rem;
		}

		.about-stats {
			flex-direction: column;
			gap: 0;
		}

		/* Align the visible icons, not their touch targets, with the text column. */
		.social-links {
			margin-right: 0;
			margin-left: calc((2.75rem - 1.35rem) / -2);
		}
	}

	/* Touch screens have no hover: keep the icons still after a tap. */
	@media (hover: none), (pointer: coarse) {
		.social-links a:hover {
			color: var(--color-text-secondary);
			translate: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.social-links a,
		.stat-trigger {
			transition: none;
		}
	}
</style>
