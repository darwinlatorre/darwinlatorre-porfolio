---
import { siGithub, siX } from 'simple-icons';
import { profile, socialLinks as portfolioSocialLinks } from '../../data/portfolio';
import TerminalPrompt from '../terminal/TerminalPrompt.astro';

const socialLinks = portfolioSocialLinks.map((link) => ({
	...link,
	icon: link.label === 'GitHub' ? siGithub : link.label === 'X' ? siX : undefined,
	mark: link.label === 'LinkedIn' ? 'in' : undefined,
}));

const descriptionParts = profile.description.split(
	/(DevOps and Backend Engineer|AWS, GCP, Kubernetes, Terraform, CI\/CD, and Spring Boot)/,
);
---

<section id="about" class="screen about" aria-label="About" data-about>
	<div
		class="about-content"
		tabindex="0"
		aria-label="About terminal content"
		data-about-content
		data-terminal-scroll
	>
		<div class="terminal-layout">
			<section class="terminal-block">
				<p class="command-line" data-about-marker>
					<span class="prompt">
						<span class="prompt-host">darwinlatorre ~/about</span><span class="prompt-symbol">$</span>
					</span>
					<code>cat resume.md</code>
				</p>

				<div class="command-output description-output" data-about-description>
					<span class="output-rule" aria-hidden="true" data-about-line></span>
					<p tabindex="0" aria-label="Professional profile description">
						{descriptionParts.map((part, index) => index % 2 === 1 ? <strong>{part}</strong> : part)}
					</p>
				</div>
			</section>

			<section class="terminal-block">
				<p class="command-line" data-about-stat-command>
					<span class="prompt">
						<span class="prompt-host">~/about</span><span class="prompt-symbol">$</span>
					</span>
					<code>tail -n 2 resume.md</code>
				</p>

				<div class="command-output stats-output">
					<div class="stat-row" data-about-stat-value>
						<span>experience_years:</span>
						<strong>{profile.experienceYears}</strong>
					</div>
					<button
						class="stat-row stat-trigger"
						type="button"
						aria-haspopup="dialog"
						data-technologies-open
						data-about-stat-value
					>
						<span>technologies_used:</span>
						<strong>{profile.technologiesUsed}</strong>
					</button>
				</div>
			</section>

			<section class="terminal-block links-block">
				<p class="command-line" data-about-social-command>
					<span class="prompt">
						<span class="prompt-host">~/about</span><span class="prompt-symbol">$</span>
					</span>
					<code>grep "links" resume.md</code>
				</p>

				<nav class="command-output social-links" aria-label="Social profiles">
					{
						socialLinks.map(({ label, href, icon, mark }) => (
							<a
								href={href}
								target="_blank"
								rel="noreferrer"
								aria-label={label}
								data-about-social
							>
								<span class="social-diamond" aria-hidden="true">
									{icon ? (
										<svg class="brand-icon" viewBox="0 0 24 24">
											<path d={icon.path} />
										</svg>
									) : (
										<span class="social-mark">{mark}</span>
									)}
								</span>
								<span class="social-name">{label}</span>
							</a>
						))
					}
				</nav>
			</section>

			<section class="terminal-block interactive-block" data-about-terminal-command>
				<TerminalPrompt context="about" responseId="about-terminal-response" />
			</section>
		</div>
	</div>
</section>

<style>
	.about {
		--about-header-space: calc(var(--page-inset) + var(--control-offset) + 3.75rem);
		--about-footer-space: calc(var(--page-inset) + var(--control-offset) + 2.75rem);
		--about-font-size: var(--terminal-font-size);

		display: grid;
		overflow: hidden;
		grid-template-rows: var(--about-header-space) minmax(0, 1fr) var(--about-footer-space);
	}

	.about-content {
		display: grid;
		width: min(var(--content-max-width), 100%);
		height: 100%;
		min-height: 0;
		margin: 0 auto;
		padding: 0 var(--content-gutter) 0.75rem;
		overflow-y: auto;
		grid-row: 2;
		align-items: safe center;
		scrollbar-width: none;
	}

	.about-content::-webkit-scrollbar {
		display: none;
	}

	.about-content.is-scroll-contained {
		overscroll-behavior-y: contain;
	}

	.terminal-layout {
		display: grid;
		width: 100%;
		gap: clamp(1.8rem, 4vh, 3.25rem);
	}

	.terminal-block {
		display: grid;
		gap: clamp(1rem, 2.2vh, 1.55rem);
	}

	.command-line {
		display: flex;
		margin: 0;
		align-items: baseline;
		gap: 0.8rem;
		color: var(--color-text-secondary);
		font-size: var(--about-font-size);
		letter-spacing: 0.015em;
		line-height: 1.4;
	}

	.command-line code {
		color: inherit;
		font: inherit;
	}

	.prompt {
		display: inline-flex;
		flex: 0 0 auto;
		gap: 0.5em;
		color: var(--color-accent);
	}

	.prompt .prompt-host {
		color: var(--color-accent);
	}

	.prompt-symbol {
		color: var(--color-accent);
	}

	.command-output {
		position: relative;
		margin-left: clamp(3.5rem, 7vw, 5.5rem);
		padding-left: clamp(1.5rem, 3vw, 2.9rem);
		border-left: 1px solid var(--color-accent-muted);
	}

	.description-output {
		border-left: 0;
	}

	.output-rule {
		position: absolute;
		top: 0;
		bottom: 0;
		left: 0;
		width: 1px;
		background: var(--color-accent-muted);
		transform-origin: top;
	}

	.description-output p {
		width: min(64rem, 100%);
		margin: 0;
		color: var(--color-text);
		font-size: 1.25rem;
		letter-spacing: 0;
		line-height: 1.6;
	}

	.description-output strong {
		font-weight: 400;
	}

	.stats-output {
		display: grid;
		width: fit-content;
		gap: 0.45rem;
	}

	.stat-row {
		display: grid;
		grid-template-columns: auto auto;
		align-items: baseline;
		justify-content: start;
		gap: 0.9rem;
		color: var(--color-text);
		font-size: var(--about-font-size);
		letter-spacing: 0.01em;
		line-height: 1.3;
	}

	.stat-row strong {
		font: inherit;
		font-weight: 600;
		color: color-mix(in srgb, var(--color-text) 85%, var(--color-accent));
	}

	button.stat-row {
		padding: 0;
		border: 0;
		background: transparent;
		font-family: inherit;
		text-align: left;
		cursor: pointer;
		transition: color var(--duration-fast) ease, transform var(--duration-fast) ease;
	}

	button.stat-trigger {
		text-decoration: underline;
		text-decoration-color: var(--color-accent-muted);
		text-underline-offset: 3px;
		text-decoration-thickness: 1px;
	}

	button.stat-row:hover,
	button.stat-row:focus-visible {
		color: var(--color-accent);
		transform: translateX(3px);
	}

	button.stat-row:focus-visible {
		outline: 1px solid var(--color-accent-muted);
		outline-offset: 4px;
	}

	.social-links {
		display: grid;
		width: fit-content;
		gap: 1.55rem;
	}

	.social-links a {
		display: grid;
		grid-template-columns: 2.5rem auto;
		align-items: center;
		gap: 1rem;
		color: var(--color-text);
		text-decoration: none;
	}

	.social-diamond {
		display: grid;
		width: 2rem;
		aspect-ratio: 1;
		place-items: center;
		border: 1px solid var(--color-accent-muted);
		transform: rotate(45deg);
		transition: border-color 180ms ease, transform 220ms var(--ease-out);
	}

	.brand-icon,
	.social-mark {
		width: 0.95rem;
		height: 0.95rem;
		color: var(--color-text);
		fill: currentColor;
		transform: rotate(-45deg);
		transition: color 180ms ease;
	}

	.social-mark {
		display: grid;
		place-items: center;
		font-size: 0.72rem;
		font-weight: 500;
		letter-spacing: -0.08em;
		line-height: 1;
	}

	.social-name {
		font-size: var(--about-font-size);
		letter-spacing: 0.01em;
	}

	.social-links a:hover .social-diamond,
	.social-links a:focus-visible .social-diamond {
		border-color: var(--color-accent);
		transform: translateY(-2px) rotate(45deg);
	}

	.social-links a:hover .brand-icon,
	.social-links a:focus-visible .brand-icon,
	.social-links a:hover .social-mark,
	.social-links a:focus-visible .social-mark,
	.social-links a:hover .social-name,
	.social-links a:focus-visible .social-name {
		color: color-mix(in srgb, var(--color-accent) 72%, var(--color-text));
	}

	.social-links a:focus-visible {
		outline: 1px solid var(--color-accent-muted);
		outline-offset: 4px;
	}

	@media (max-width: 48rem) {
		.about {
			--about-header-space: calc(var(--page-inset) + var(--control-offset) + 3rem);
			--about-footer-space: calc(var(--page-inset) + var(--control-offset) + 2.5rem);
		}

		.about-content {
			padding: 0.25rem var(--content-gutter) 0.5rem;
			align-items: start;
			overflow-y: auto;
			scrollbar-width: thin;
		}

		.terminal-layout {
			width: min(34rem, 100%);
			min-width: 0;
			margin-inline: auto;
			gap: calc(clamp(0.65rem, 1.8dvh, 1rem) + 0.3dvh);
		}

		.terminal-block {
			min-width: 0;
			gap: 0.4rem;
		}

		.command-line {
			flex-wrap: wrap;
			gap: 0.2rem 0.5rem;
			font-size: 0.85rem;
			line-height: 1.55;
		}

		.command-line code {
			overflow-wrap: anywhere;
		}

		.command-output {
			margin-left: 0;
			padding-left: 1rem;
		}

		.description-output p {
			max-height: clamp(6rem, calc(100dvh - 30rem), 24rem);
			overflow-y: auto;
			font-size: 1.15rem;
			line-height: 1.6;
			letter-spacing: 0;
			scrollbar-width: thin;
		}

		.description-output p:focus-visible {
			outline: 1px solid var(--color-accent-muted);
			outline-offset: 3px;
		}

		.stats-output {
			width: 100%;
			padding-block: 0;
			gap: 0.25rem;
		}

		.stat-row {
			min-height: 1.4rem;
			grid-template-columns: auto auto;
			align-items: center;
			gap: 0.7rem;
			font-size: 0.85rem;
		}

		.stat-row strong {
			font-size: inherit;
		}

		.social-links {
			width: fit-content;
			padding: 0.5rem 0.4rem 0.25rem;
			grid-template-columns: repeat(3, auto);
			gap: 1.35rem;
			border-left: 0;
		}

		.social-links a {
			min-height: 3.1rem;
			grid-template-columns: 1fr;
			justify-items: center;
			gap: 0.5rem;
		}

		.social-diamond {
			width: 1.8rem;
		}

		.social-name {
			font-size: 0.65rem;
		}

		.interactive-block {
			padding-top: 0.6rem;
			border-top: 1px dashed var(--color-accent-muted);
		}

	}

	@media (min-width: 48.01rem) and (max-height: 50rem) {
		.social-links {
			display: flex;
			gap: 2rem;
			width: fit-content;
		}

		.social-links a {
			grid-template-columns: auto;
			gap: 0;
		}

		.social-name {
			display: none;
		}
	}

	@media (hover: none), (pointer: coarse) {
		.social-links a:hover .social-diamond {
			border-color: var(--color-accent-muted);
			transform: rotate(45deg);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.social-diamond,
		.brand-icon,
		.social-mark {
			transition: none;
		}
	}
</style>
