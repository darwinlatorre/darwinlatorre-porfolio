---
interface Props {
	type: 'home' | 'folder' | 'file';
}

const { type } = Astro.props;
---

<svg class="tree-icon" viewBox="0 0 24 24" aria-hidden="true">
	{
		type === 'home' ? (
			<>
				<path d="m4 10 8-6 8 6"></path>
				<path d="M6.5 9v10h11V9M10 19v-5h4v5"></path>
			</>
		) : type === 'folder' ? (
			<>
				<path d="M3 6h7l2 2h9v11H3z"></path>
				<path d="M3 8h18"></path>
			</>
		) : (
			<>
				<path d="M6 3h8l4 4v14H6z"></path>
				<path d="M14 3v5h4"></path>
			</>
		)
	}
</svg>

<style>
	.tree-icon {
		display: block;
		width: 1rem;
		height: 1rem;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.5;
	}
</style>
