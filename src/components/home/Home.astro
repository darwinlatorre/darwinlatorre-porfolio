---
import Hero from './Hero.astro';
import HomeDetails from './HomeDetails.astro';
---

<section id="home" class="home" aria-label="Home">
	<Hero />
	<HomeDetails />
</section>

<style>
	.home {
		display: flex;
		width: 100%;
		flex: 0 0 auto;
		flex-direction: column;
	}

	/* Home and its details are fixed viewport views; later sections grow with content. */
	.home > :global(.screen) {
		height: 100vh;
		height: 100dvh;
	}
</style>
