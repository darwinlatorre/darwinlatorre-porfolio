---
const menuItems = [
	{ label: 'About', href: '#about' },
	{ label: 'Projects', href: '#projects' },
	{ label: 'Experience', href: '#experience' },
	{ label: 'Services', href: '#services' },
	{ label: 'Certificates', href: '#certificates' },
];
---

<div class="menu-shell" data-menu>
	<button
		class="menu-trigger"
		type="button"
		aria-label="Open navigation"
		aria-controls="site-menu"
		aria-expanded="false"
		data-menu-trigger
	>
		<span></span>
		<span></span>
		<span></span>
	</button>

	<nav
		id="site-menu"
		class="menu-panel"
		aria-label="Primary navigation"
		aria-hidden="true"
		data-menu-panel
		inert
	>
		<ul>
			{
				menuItems.map((item) => (
					<li>
						<a href={item.href}>
							<svg class="folder-icon" viewBox="0 0 28 24" aria-hidden="true">
								<path d="M2 5.5h8l2.2 2.5H26v13.5H2z"></path>
								<path d="M2 8h24"></path>
							</svg>
							<span>{item.label}</span>
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</div>

<script>
	const menus = document.querySelectorAll<HTMLElement>('[data-menu]');

	for (const menu of menus) {
		const trigger = menu.querySelector<HTMLButtonElement>('[data-menu-trigger]');
		const panel = menu.querySelector<HTMLElement>('[data-menu-panel]');

		if (!trigger || !panel) continue;

		const setOpen = (open: boolean) => {
			menu.classList.toggle('is-open', open);
			trigger.setAttribute('aria-expanded', String(open));
			trigger.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
			panel.setAttribute('aria-hidden', String(!open));
			panel.inert = !open;
		};

		trigger.addEventListener('click', () => {
			setOpen(trigger.getAttribute('aria-expanded') !== 'true');
		});

		panel.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => setOpen(false));
		});

		document.addEventListener('click', (event) => {
			if (
				menu.classList.contains('is-open') &&
				event.target instanceof Node &&
				!menu.contains(event.target)
			) {
				setOpen(false);
			}
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && menu.classList.contains('is-open')) {
				setOpen(false);
				trigger.focus();
			}
		});
	}
</script>

<style>
	.menu-shell {
		position: absolute;
		top: var(--control-offset);
		left: var(--control-offset);
		z-index: 10;
		animation: detail-enter 550ms ease-out 450ms both;
	}

	.menu-trigger {
		position: relative;
		z-index: 2;
		display: grid;
		width: 2rem;
		height: 1.75rem;
		padding: 0.35rem 0.25rem;
		align-content: space-between;
		border: 0;
		background: transparent;
		cursor: pointer;
	}

	.menu-trigger span {
		display: block;
		width: 1.35rem;
		height: 1px;
		background: var(--color-accent-muted);
		transform-origin: center;
		transition: background-color var(--duration-fast) ease,
			opacity var(--duration-fast) ease, transform 220ms ease;
	}

	.menu-trigger:hover span,
	.menu-trigger:focus-visible span,
	.is-open .menu-trigger span {
		background: var(--color-accent);
	}

	.menu-trigger:hover span:nth-child(2),
	.menu-trigger:focus-visible span:nth-child(2) {
		transform: translateX(2px);
	}

	.menu-trigger:focus-visible {
		outline: var(--border-width) solid var(--color-accent-muted);
		outline-offset: 4px;
	}

	.menu-trigger:active {
		transform: scale(0.97);
	}

	.is-open .menu-trigger span:first-child {
		transform: translateY(7px) rotate(45deg);
	}

	.is-open .menu-trigger span:nth-child(2) {
		opacity: 0;
		transform: scaleX(0.25);
	}

	.is-open .menu-trigger span:last-child {
		transform: translateY(-7px) rotate(-45deg);
	}

	.menu-panel {
		position: absolute;
		top: -0.75rem;
		left: -0.75rem;
		width: min(17rem, calc(100vw - 3.5rem));
		padding: 1.1rem 1.35rem 1.4rem;
		visibility: hidden;
		border: var(--border-width) solid var(--color-border);
		border-radius: var(--radius-small);
		background: var(--color-surface-raised);
		opacity: 0;
		transform: translateX(-12px);
		transition: opacity 200ms ease, transform 280ms var(--ease-out),
			visibility 0s linear 280ms;
	}

	.is-open .menu-panel {
		visibility: visible;
		opacity: 1;
		transform: translateX(0);
		transition-delay: 0s;
	}

	.menu-panel ul {
		position: relative;
		display: grid;
		margin: 2.35rem 0 0;
		padding: 0;
		list-style: none;
	}

	.menu-panel ul::before {
		position: absolute;
		top: 0.25rem;
		bottom: 1.5rem;
		left: 0.28rem;
		border-left: 2px dotted var(--color-accent-muted);
		content: '';
		opacity: 0.78;
	}

	.menu-panel li {
		position: relative;
		display: grid;
		min-height: 3rem;
		grid-template-columns: 1.55rem minmax(0, 1fr);
		align-items: center;
		column-gap: 0.6rem;
		opacity: 0;
		transform: translateY(5px);
		transition: opacity 180ms ease, transform 220ms ease;
	}

	.menu-panel li::before {
		position: absolute;
		top: 50%;
		left: 0.28rem;
		width: 1.05rem;
		border-top: 2px dotted var(--color-accent-muted);
		content: '';
		opacity: 0.78;
	}

	.is-open .menu-panel li {
		opacity: 1;
		transform: translateY(0);
	}

	.is-open .menu-panel li:nth-child(1) {
		transition-delay: 90ms;
	}

	.is-open .menu-panel li:nth-child(2) {
		transition-delay: 120ms;
	}

	.is-open .menu-panel li:nth-child(3) {
		transition-delay: 150ms;
	}

	.is-open .menu-panel li:nth-child(4) {
		transition-delay: 180ms;
	}

	.is-open .menu-panel li:nth-child(5) {
		transition-delay: 210ms;
	}

	.folder-icon {
		width: 1.35rem;
		height: auto;
		fill: none;
		stroke: var(--color-text-muted);
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.5;
		transition: stroke var(--duration-fast) ease;
	}

	.menu-panel li > a {
		display: grid;
		grid-column: 2;
		grid-template-columns: 1.4rem minmax(0, 1fr);
		align-items: center;
		align-self: stretch;
		gap: 0.6rem;
		color: var(--color-text-muted);
		font-size: 1.05rem;
		letter-spacing: 0.035em;
		text-decoration: none;
		transition: color var(--duration-fast) ease, transform var(--duration-fast) ease;
	}

	.menu-panel li > a:hover,
	.menu-panel li > a:focus-visible {
		color: var(--color-text);
		transform: translateX(3px);
	}

	.menu-panel li > a:hover .folder-icon,
	.menu-panel li > a:focus-visible .folder-icon {
		stroke: var(--color-accent);
	}

	.menu-panel li > a:focus-visible {
		outline: var(--border-width) solid var(--color-accent-muted);
		outline-offset: 3px;
	}

	@keyframes detail-enter {
		from {
			opacity: 0;
			transform: translateY(4px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.menu-shell,
		.menu-trigger span,
		.menu-panel,
		.menu-panel li,
		.menu-panel a,
		.folder-icon {
			animation: none;
			transition-duration: 0.01ms;
		}
	}
</style>
