<div class="menu-shell" data-menu>
	<button
		class="menu-trigger"
		type="button"
		aria-label="Open navigation"
		aria-controls="site-menu"
		aria-expanded="false"
		data-menu-trigger
	>
		<span></span>
		<span></span>
		<span></span>
	</button>

	<nav
		id="site-menu"
		class="menu-panel"
		aria-label="Primary navigation"
		aria-hidden="true"
		data-menu-panel
		inert
	>
		<ul>
			<li><a href="#about">About</a></li>
			<li><a href="#projects">Projects</a></li>
			<li><a href="#experience">Experience</a></li>
			<li><a href="#services">Services</a></li>
			<li><a href="#certificates">Certificates</a></li>
		</ul>
	</nav>
</div>

<script>
	const menus = document.querySelectorAll<HTMLElement>('[data-menu]');

	for (const menu of menus) {
		const trigger = menu.querySelector<HTMLButtonElement>('[data-menu-trigger]');
		const panel = menu.querySelector<HTMLElement>('[data-menu-panel]');

		if (!trigger || !panel) continue;

		const setOpen = (open: boolean) => {
			menu.classList.toggle('is-open', open);
			trigger.setAttribute('aria-expanded', String(open));
			trigger.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
			panel.setAttribute('aria-hidden', String(!open));
			panel.inert = !open;
		};

		trigger.addEventListener('click', () => {
			setOpen(trigger.getAttribute('aria-expanded') !== 'true');
		});

		panel.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => setOpen(false));
		});

		document.addEventListener('click', (event) => {
			if (
				menu.classList.contains('is-open') &&
				event.target instanceof Node &&
				!menu.contains(event.target)
			) {
				setOpen(false);
			}
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && menu.classList.contains('is-open')) {
				setOpen(false);
				trigger.focus();
			}
		});
	}
</script>

<style>
	.menu-shell {
		position: absolute;
		top: clamp(1.25rem, 2.5vw, 2.35rem);
		left: clamp(1.25rem, 2.5vw, 2.35rem);
		z-index: 10;
		animation: detail-enter 550ms ease-out 450ms both;
	}

	.menu-trigger {
		position: relative;
		z-index: 2;
		display: grid;
		width: 2rem;
		height: 1.75rem;
		padding: 0.35rem 0.25rem;
		align-content: space-between;
		border: 0;
		background: transparent;
		cursor: pointer;
	}

	.menu-trigger span {
		display: block;
		width: 1.35rem;
		height: 1px;
		background: #715081;
		transform-origin: center;
		transition: background-color 180ms ease, opacity 180ms ease, transform 220ms ease;
	}

	.menu-trigger:hover span,
	.menu-trigger:focus-visible span,
	.is-open .menu-trigger span {
		background: #a96ed3;
	}

	.menu-trigger:hover span:nth-child(2),
	.menu-trigger:focus-visible span:nth-child(2) {
		transform: translateX(2px);
	}

	.menu-trigger:focus-visible {
		outline: 1px solid #715081;
		outline-offset: 4px;
	}

	.menu-trigger:active {
		transform: scale(0.97);
	}

	.is-open .menu-trigger span:first-child {
		transform: translateY(7px) rotate(45deg);
	}

	.is-open .menu-trigger span:nth-child(2) {
		opacity: 0;
		transform: scaleX(0.25);
	}

	.is-open .menu-trigger span:last-child {
		transform: translateY(-7px) rotate(-45deg);
	}

	.menu-panel {
		position: absolute;
		top: -0.75rem;
		left: -0.75rem;
		width: min(14rem, calc(100vw - 3.5rem));
		padding: 4.15rem 1.5rem 1.45rem;
		visibility: hidden;
		border: 1px solid #4d3659;
		border-radius: 0.25rem 1.5rem 1.5rem 1.5rem;
		background: #121118;
		opacity: 0;
		transform: translate(-6px, -6px) scale(0.72);
		transform-origin: top left;
		transition: opacity 220ms ease, transform 320ms cubic-bezier(0.22, 1, 0.36, 1),
			visibility 0s linear 320ms;
	}

	.is-open .menu-panel {
		visibility: visible;
		opacity: 1;
		transform: translate(0, 0) scale(1);
		transition-delay: 0s;
	}

	.menu-panel ul {
		display: grid;
		margin: 0;
		padding: 0;
		gap: 0.2rem;
		list-style: none;
	}

	.menu-panel li {
		opacity: 0;
		transform: translateY(5px);
		transition: opacity 180ms ease, transform 220ms ease;
	}

	.is-open .menu-panel li {
		opacity: 1;
		transform: translateY(0);
	}

	.is-open .menu-panel li:nth-child(1) {
		transition-delay: 90ms;
	}

	.is-open .menu-panel li:nth-child(2) {
		transition-delay: 120ms;
	}

	.is-open .menu-panel li:nth-child(3) {
		transition-delay: 150ms;
	}

	.is-open .menu-panel li:nth-child(4) {
		transition-delay: 180ms;
	}

	.is-open .menu-panel li:nth-child(5) {
		transition-delay: 210ms;
	}

	.menu-panel a {
		display: block;
		padding: 0.65rem 0;
		color: #938a99;
		font-size: 0.82rem;
		letter-spacing: 0.035em;
		text-decoration: none;
		transition: color 180ms ease, transform 180ms ease;
	}

	.menu-panel a:hover,
	.menu-panel a:focus-visible {
		color: #efefef;
		transform: translateX(3px);
	}

	.menu-panel a:focus-visible {
		outline: 1px solid #715081;
		outline-offset: 3px;
	}

	@keyframes detail-enter {
		from {
			opacity: 0;
			transform: translateY(4px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.menu-shell,
		.menu-trigger span,
		.menu-panel,
		.menu-panel li,
		.menu-panel a {
			animation: none;
			transition-duration: 0.01ms;
		}
	}
</style>
