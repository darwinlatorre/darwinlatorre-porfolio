---
const navigationItems = [
	{ label: 'Home', href: '#' },
	{ label: 'About', href: '#about' },
	{ label: 'Projects', href: '#projects' },
];

const projects = [
	{ label: 'Project 01', href: '#project-01' },
	{ label: 'Project 02', href: '#project-02' },
];
---

<section class="full-screen second-screen" id="about" data-second-screen>
	<div class="second-content">
		<div class="introduction">
			<p class="eyebrow" data-second-reveal>Hi, I'm</p>
			<h2 data-second-reveal>Dark<span>_</span></h2>

			<div class="actions">
				<a href="#contact" data-second-reveal><span>&gt;</span> Pull Contact</a>
				<a href="#cv" data-second-reveal><span>&gt;</span> Pull CV</a>
			</div>
		</div>

		<div class="separator" aria-hidden="true" data-second-reveal></div>

		<nav class="directory" aria-label="Portfolio sections">
			<ul>
				{
					navigationItems.map((item) => (
						<li data-second-reveal>
							<a href={item.href}>{item.label}</a>
						</li>
					))
				}
				<li class="project-children">
					<ul>
						{
							projects.map((project) => (
								<li data-second-reveal>
									<a href={project.href}>{project.label}</a>
								</li>
							))
						}
					</ul>
				</li>
			</ul>
		</nav>
	</div>
</section>

<style>
	.second-screen {
		display: grid;
		place-items: center;
		padding: clamp(5.5rem, 12vh, 8rem) clamp(2rem, 8vw, 8rem)
			clamp(5rem, 10vh, 7rem);
	}

	.second-content {
		display: grid;
		width: min(68rem, 100%);
		grid-template-columns: minmax(0, 1fr) 1px minmax(0, 1fr);
		align-items: center;
		gap: clamp(2.5rem, 6vw, 5rem);
	}

	.introduction {
		display: grid;
		justify-items: start;
	}

	.eyebrow {
		margin: 0 0 0.35rem;
		color: var(--color-text-muted);
		font-size: clamp(0.82rem, 1.2vw, 1rem);
	}

	h2 {
		margin: 0;
		font-size: clamp(2.25rem, 5vw, 4.5rem);
		font-weight: 500;
		letter-spacing: -0.06em;
		line-height: 1;
	}

	h2 span,
	.actions span {
		color: var(--color-accent);
	}

	.actions {
		display: grid;
		margin-top: clamp(1.75rem, 4vh, 3rem);
		gap: 0.7rem;
	}

	.actions a {
		color: var(--color-text-muted);
		font-size: clamp(0.75rem, 1vw, 0.88rem);
		text-decoration: none;
		transition: color var(--duration-fast) ease, transform var(--duration-fast) ease;
	}

	.actions a:hover,
	.actions a:focus-visible {
		color: var(--color-text);
		transform: translateX(3px);
	}

	.actions a:focus-visible,
	.directory a:focus-visible {
		outline: var(--border-width) solid var(--color-accent-muted);
		outline-offset: 4px;
	}

	.separator {
		width: 1px;
		height: min(18rem, 42vh);
		background: var(--color-border);
	}

	.directory ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.directory > ul {
		display: grid;
		gap: 0.85rem;
	}

	.directory a {
		color: var(--color-text-muted);
		font-size: clamp(0.85rem, 1.3vw, 1.05rem);
		text-decoration: none;
		transition: color var(--duration-fast) ease, transform var(--duration-fast) ease;
	}

	.directory a::before {
		margin-right: 0.65rem;
		color: var(--color-accent-muted);
		content: '>';
	}

	.directory a:hover,
	.directory a:focus-visible {
		color: var(--color-text);
	}

	.project-children {
		margin: -0.35rem 0 0 1.25rem;
		padding-left: 1rem;
		border-left: 1px dotted var(--color-accent-muted);
	}

	.project-children ul {
		display: grid;
		gap: 0.65rem;
	}

	.project-children a {
		font-size: clamp(0.72rem, 1vw, 0.86rem);
	}

	.project-children a::before {
		color: var(--color-border);
		content: '-';
	}

	@media (max-width: 42rem) {
		.second-screen {
			padding: 5rem 2.25rem 4.5rem;
		}

		.second-content {
			grid-template-columns: 1fr;
			align-content: center;
			gap: 1.25rem;
		}

		.separator {
			width: 100%;
			height: 1px;
		}

		.actions {
			margin-top: 1.25rem;
			grid-template-columns: repeat(2, auto);
			gap: 1.25rem;
		}

		.directory > ul {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 0.65rem;
		}

		.project-children {
			grid-column: 1 / -1;
			margin: 0;
			padding: 0.7rem 0 0;
			border-top: 1px dotted var(--color-accent-muted);
			border-left: 0;
		}

		.project-children ul {
			grid-template-columns: repeat(2, auto);
		}
	}
</style>
