---
import MenuButton from './MenuButton.astro';
---

<main class="hero" aria-label="Darwin Latorre portfolio introduction">
	<MenuButton />

	<h1 class="terminal-line" aria-label="Darwin Latorre">
		<span class="prompt" aria-hidden="true">&gt;</span>
		<span>Darwinlatorre</span><span class="cursor" aria-hidden="true">_</span>
	</h1>

	<div class="scroll-cue" aria-hidden="true">
		<span>Scroll</span>
		<svg viewBox="0 0 16 10" role="presentation">
			<path d="M2 2.25 8 8l6-5.75"></path>
		</svg>
	</div>
</main>

<style>
	.hero {
		position: relative;
		display: grid;
		width: 100%;
		height: 100%;
		place-items: center;
		border: var(--border-width) solid var(--color-border);
		border-radius: var(--radius-frame);
		background: var(--color-surface);
		animation: frame-enter 700ms var(--ease-out) both;
	}

	.terminal-line {
		display: flex;
		margin: 0;
		align-items: baseline;
		white-space: nowrap;
		font-size: clamp(1.45rem, 7.25vw, 3.5rem);
		font-weight: 500;
		letter-spacing: -0.045em;
		line-height: 1;
		animation: title-enter 750ms var(--ease-out) 160ms both;
	}

	.prompt {
		margin-right: 0.32em;
		color: var(--color-accent);
		text-shadow: 0 0 7px var(--color-accent-glow);
	}

	.cursor {
		color: var(--color-accent);
		text-shadow: 0 0 7px var(--color-accent-glow-faint);
		animation: cursor-blink 1.2s step-end 1.15s infinite;
	}

	.scroll-cue {
		position: absolute;
		bottom: var(--control-offset);
		left: 50%;
		display: grid;
		transform: translateX(-50%);
		place-items: center;
		gap: 0.55rem;
		color: var(--color-text-muted);
		font-size: 0.68rem;
		letter-spacing: 0.08em;
		animation: detail-enter-centered 550ms ease-out 650ms both;
	}

	.scroll-cue svg {
		width: 0.75rem;
		height: auto;
		overflow: visible;
		animation: scroll-drift 1.8s ease-in-out 1.2s infinite;
	}

	.scroll-cue path {
		fill: none;
		stroke: var(--color-accent-muted);
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.25;
	}

	@keyframes frame-enter {
		from {
			opacity: 0;
			transform: scale(0.995);
		}
		to {
			opacity: 1;
			transform: scale(1);
		}
	}

	@keyframes title-enter {
		from {
			opacity: 0;
			transform: translateY(8px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes detail-enter-centered {
		from {
			opacity: 0;
			transform: translate(-50%, 4px);
		}
		to {
			opacity: 1;
			transform: translate(-50%, 0);
		}
	}

	@keyframes cursor-blink {
		0%,
		45% {
			opacity: 1;
		}
		46%,
		100% {
			opacity: 0.16;
		}
	}

	@keyframes scroll-drift {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(3px);
		}
	}

	@media (max-width: 40rem) {
		.terminal-line {
			letter-spacing: -0.055em;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero,
		.terminal-line,
		.scroll-cue,
		.scroll-cue svg,
		.cursor {
			animation: none;
		}
	}
</style>
