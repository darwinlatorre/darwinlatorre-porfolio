---
import { ArrowUpRight } from '@lucide/astro';
import { experiences, experienceSummary } from '../../data/portfolio';
---

<section
	id="experience"
	class="screen experience"
	aria-label="Experience"
	data-experience
>
	<div class="experience-content">
		<p class="command-line" data-experience-command>
			<span class="prompt">
				<span>darwinlatorre ~/experience</span><span>$</span>
			</span>
			<code data-typed-command>tail -n 100 experience.log</code>
		</p>

		<ol class="experience-log" aria-label="Employment history">
			{
				experiences.map((experience) => (
					<li class="experience-entry" data-experience-entry>
						<span class="entry-marker" aria-hidden="true"></span>
						<p class="entry-period">
							<time datetime={experience.start}>{experience.startLabel}</time>
							<span aria-hidden="true"> - </span>
							<span class="visually-hidden"> to </span>
							<time datetime={experience.end}>{experience.endLabel}</time>
						</p>
						<div class="entry-body">
							<h3 class="entry-title">
								<span class="entry-role">{experience.role}</span>
								<span class="entry-company">
									@ {experience.companyHref ? (
										<a
											class="company-link"
											href={experience.companyHref}
											target="_blank"
											rel="noreferrer"
											aria-label={`${experience.company} (opens in a new tab)`}
										>
											{experience.company}
											<ArrowUpRight class="company-arrow" size={14} stroke-width={1.75} aria-hidden="true" />
										</a>
									) : experience.company}{experience.location && ` / ${experience.location}`}
								</span>
							</h3>
							<p class="entry-summary">{experience.summary}</p>
							<ul class="entry-stack" aria-label={`Technologies used at ${experience.company}`}>
								{experience.stack.map((technology) => <li>{technology}</li>)}
							</ul>
						</div>
					</li>
				))
			}
		</ol>

		<div class="experience-footer" data-experience-summary>
			<p class="experience-summary">
				<strong class="summary-label">summary</strong>
				<span class="summary-brace">{'{ '}</span>{experienceSummary}<span class="summary-brace">{' }'}</span>
			</p>
		</div>
	</div>
</section>

<style>
	.experience {
		--experience-date-width: 10.5rem;
		--experience-column-gap: clamp(1.25rem, 3vw, 2.5rem);
		--experience-entry-padding: clamp(1rem, 2vw, 1.5rem);
		--experience-marker-size: 0.5rem;
		--experience-rail: 1.25rem;
		--experience-line-height: 1.65;

		display: grid;
		grid-template-rows: var(--section-space-start) auto var(--section-space-end);
	}

	.experience-content {
		display: grid;
		width: min(var(--content-max-width), 100%);
		margin: 0 auto;
		padding-inline: var(--content-gutter);
		grid-row: 2;
		gap: clamp(1.75rem, 4vh, 2.75rem);
	}

	.command-line {
		display: flex;
		margin: 0;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 0.25rem 0.8rem;
		color: var(--color-text-secondary);
		font-size: var(--terminal-font-size);
		letter-spacing: 0.015em;
		line-height: 1.4;
	}

	.command-line code {
		color: inherit;
		font: inherit;
	}

	.prompt {
		display: inline-flex;
		flex: 0 0 auto;
		gap: 0.5em;
		color: var(--color-accent);
	}

	.experience-log {
		position: relative;
		display: grid;
		margin: 0;
		padding: 0 0 0 var(--experience-rail);
		gap: clamp(0.5rem, 1.5vh, 1rem);
		list-style: none;
	}

	/* The log rail keeps the terminal timeline feel next to each entry marker. */
	.experience-log::before {
		position: absolute;
		top: 1.75rem;
		bottom: 1.75rem;
		left: calc(var(--experience-marker-size) / 2);
		border-left: 1px solid color-mix(in srgb, var(--color-text-muted) 22%, transparent);
		content: '';
	}

	.experience-entry {
		position: relative;
		display: grid;
		padding: var(--experience-entry-padding);
		grid-template-columns: var(--experience-date-width) minmax(0, 46rem);
		column-gap: var(--experience-column-gap);
		align-items: baseline;
		border-radius: var(--radius-small);
		transition:
			background-color 240ms ease,
			box-shadow 240ms ease;
	}

	/* Dimming targets the children: the entry's own opacity is driven by the scroll reveal. */
	.experience-entry > * {
		transition: opacity 240ms ease;
	}

	.entry-marker {
		position: absolute;
		top: calc(var(--experience-entry-padding) + 0.55rem);
		left: calc(var(--experience-rail) * -1);
		width: var(--experience-marker-size);
		height: var(--experience-marker-size);
		border-radius: 50%;
		background: var(--color-accent-muted);
		transition: background-color 240ms ease, box-shadow 240ms ease;
	}

	.entry-period {
		margin: 0;
		color: var(--color-text-muted);
		font-size: 0.75rem;
		letter-spacing: 0.04em;
		line-height: 1.9;
		white-space: nowrap;
	}

	.entry-body {
		display: grid;
		min-width: 0;
		gap: 0.85rem;
	}

	.entry-title {
		display: flex;
		margin: 0;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 0.15rem 0.6rem;
		font-size: 1rem;
		font-weight: 400;
		line-height: 1.4;
	}

	.entry-role {
		color: var(--color-text);
		font-size: 1.15rem;
		font-weight: 600;
		transition: color 240ms ease;
	}

	.entry-company {
		color: var(--color-accent);
		font-size: 0.9rem;
	}

	.company-link {
		display: inline-flex;
		align-items: flex-start;
		gap: 0.15rem;
		color: inherit;
		text-decoration: none;
	}

	/* The arrow sits at the top right, the usual cue for an external page. */
	:global(.company-arrow) {
		flex: 0 0 auto;
		width: 0.8rem;
		height: auto;
		margin-top: -0.1rem;
		transition: transform var(--duration-fast) var(--ease-out);
	}

	.company-link:hover :global(.company-arrow),
	.company-link:focus-visible :global(.company-arrow) {
		transform: translate(2px, -2px);
	}

	.company-link:focus-visible {
		outline: 2px solid var(--color-accent-muted);
		outline-offset: 3px;
	}

	/* One short paragraph per role; the full detail lives in the CV. */
	.entry-summary {
		max-width: 62ch;
		margin: 0;
		color: var(--color-text-secondary);
		font-size: 0.88rem;
		line-height: var(--experience-line-height);
	}

	.entry-stack {
		display: flex;
		margin: 0.15rem 0 0;
		padding: 0;
		flex-wrap: wrap;
		gap: 0.45rem;
		list-style: none;
	}

	.entry-stack li {
		padding: 0.2rem 0.6rem;
		border: 1px solid color-mix(in srgb, var(--color-accent) 22%, transparent);
		border-radius: var(--radius-small);
		background: color-mix(in srgb, var(--color-accent) 10%, transparent);
		color: color-mix(in srgb, var(--color-accent) 70%, var(--color-text));
		font-size: 0.75rem;
		line-height: 1.5;
	}

	.experience-footer {
		padding-left: calc(var(--experience-rail) + var(--experience-entry-padding));
	}

	.experience-summary {
		margin: 0;
		color: var(--color-text-muted);
		font-size: 0.85rem;
		line-height: 1.6;
	}

	.summary-label {
		margin-right: 0.6rem;
		color: var(--color-accent);
		font-weight: 400;
	}

	.summary-brace {
		color: var(--color-accent);
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	/* Pointer devices: the entry under the cursor lifts and its siblings step back. */
	@media (hover: hover) and (pointer: fine) {
		.experience-entry:hover,
		.experience-entry:focus-within {
			background: color-mix(in srgb, var(--color-surface-raised) 85%, transparent);
			box-shadow: inset 0 1px 0 color-mix(in srgb, var(--color-accent) 18%, transparent);
		}

		.experience-log:has(.experience-entry:hover) .experience-entry:not(:hover) > * {
			opacity: 0.45;
		}

		.experience-entry:hover .entry-role {
			color: var(--color-accent);
		}

		.experience-entry:hover .entry-marker {
			background: var(--color-accent);
			box-shadow: 0 0 0 4px var(--color-accent-glow);
		}
	}

	@media (max-width: 48rem) {
		.experience {
			--experience-rail: 1rem;
			--experience-entry-padding: 0.75rem;
		}

		.experience-content {
			gap: 1.5rem;
		}

		.experience-entry {
			grid-template-columns: minmax(0, 1fr);
			row-gap: 0.4rem;
			padding-inline: 0.5rem 0;
		}

		.entry-marker {
			top: calc(var(--experience-entry-padding) + 0.45rem);
		}

		.entry-role {
			font-size: 1.05rem;
		}


		.experience-footer {
			padding-left: calc(var(--experience-rail) + 0.5rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.experience-entry,
		.experience-entry > *,
		.entry-marker,
		.entry-role,
		:global(.company-arrow) {
			transition: none;
		}
	}
</style>
