---
import TerminalPrompt from '../terminal/TerminalPrompt.astro';

const experiences = [
	{
		role: 'Java Developer',
		company: 'Freelance',
		location: 'darwinlatorre',
		start: '2026-06',
		end: '2026-07',
		startLabel: 'Jun 2026',
		endLabel: 'Currently',
		highlights: [
			'Performed adjustments and maintenance on the backend of an e-commerce platform developed with Java and Spring Boot.',
			'Implemented adjustments, bug fixes, and deployments on GCP using Cloud Run, Cloud SQL, Artifact Registry, and Secret Manager.',
		],
	},
	{
		role: 'DevOps Engineer',
		company: 'Asmet Salud EPS',
		location: null,
		start: '2025-01',
		end: '2026-03',
		startLabel: 'Jan 2025',
		endLabel: 'Mar 2026',
		highlights: [
			'Implemented CI/CD pipelines with Jenkins and GitLab for deploying Spring Boot microservices on AWS using EKS.',
			'Managed on-premises Kubernetes clusters running production Spring Boot microservices, monitored with Prometheus and Grafana.',
			'Provisioned and maintained AWS infrastructure using Terraform and Terragrunt, including EKS, IAM, Secrets Manager, VPC, and RDS.',
			'Collaborated with development teams using GitLab, Jira, and Agile methodologies.',
		],
	},
	{
		role: 'IT Infrastructure Professional',
		company: 'Asmet Salud EPS',
		location: null,
		start: '2024-06',
		end: '2024-12',
		startLabel: 'Jun 2024',
		endLabel: 'Dec 2024',
		highlights: [
			'Developed a password management system with high availability (HA) and a disaster recovery plan (DRP).',
			'Managed AWS and on-premises infrastructure, Active Directory, networks, backups, and database backups.',
			'Migrated JBoss and WebLogic applications from Java 7 to Java 11, including servers and code.',
		],
	},
];
---

<section
	id="experience"
	class="screen experience"
	aria-label="Experience"
	data-experience
>
	<div
		class="experience-content"
		tabindex="0"
		aria-label="Professional experience terminal content"
		data-experience-content
		data-terminal-scroll
	>
		<div class="experience-terminal">
			<section class="terminal-block">
				<p class="command-line" data-experience-command>
					<span class="prompt">
						<span>user@</span><span class="prompt-host">darwinlatorre:</span><span>~$</span>
					</span>
					<code>tail -n 100 experience.log</code>
				</p>

				<div class="experience-log" aria-label="Employment history">
				{
					experiences.map((experience) => (
						<article class="experience-entry" data-experience-entry>
							<span class="entry-marker" aria-hidden="true"></span>
							<p class="entry-period">
								<time datetime={experience.start}>{experience.startLabel}</time>
								<span> - </span>
								<time datetime={experience.end}>{experience.endLabel}</time>
							</p>
							<details class="entry-details" open>
								<summary class="entry-summary">
									<h2 class="entry-title">
										<span class="entry-role">{experience.role}</span>
										<span class="entry-company">
											@ {experience.company}{experience.location && ` / ${experience.location}`}
										</span>
									</h2>
								</summary>
								<ul>
									{experience.highlights.map((highlight) => <li>{highlight}</li>)}
								</ul>
							</details>
						</article>
					))
				}
				<p class="experience-summary" data-experience-summary>
					<span class="entry-marker" aria-hidden="true"></span>
					<strong class="summary-label">SUMMARY</strong>
					<span class="summary-stack">
						<span class="summary-brace">{'{ '}</span>
						AWS, GCP, Kubernetes, Terraform, Jenkins, Spring Boot, GitLab CI/CD
						<span class="summary-brace">{' }'}</span>
					</span>
				</p>
				</div>
			</section>

			<section class="interactive-block" data-experience-ready>
				<TerminalPrompt context="experience" responseId="experience-terminal-response" />
			</section>
		</div>
	</div>
</section>

<style>
	.experience {
		--experience-header-space: calc(var(--page-inset) + var(--control-offset) + 4.75rem);
		--experience-footer-space: calc(var(--page-inset) + var(--control-offset) + 2.75rem);
		--experience-magenta: #d479e9;
		--experience-content-font: clamp(0.95rem, 1.35vw, 1.18rem);
		--experience-line-height: 1.55;
		--experience-log-padding: clamp(1.5rem, 3vw, 2.9rem);
		--experience-date-width: 9.4rem;
		--experience-column-gap: 1.25rem;
		--experience-marker-size: 0.55rem;
		--experience-marker-offset: calc(
			(var(--experience-content-font) * var(--experience-line-height) - var(--experience-marker-size)) / 2
		);

		display: grid;
		overflow: hidden;
		grid-template-rows: var(--experience-header-space) minmax(0, 1fr) var(--experience-footer-space);
	}

	.experience-content {
		display: grid;
		width: min(80rem, 100%);
		height: 100%;
		min-height: 0;
		margin: 0 auto;
		padding: 0 clamp(2rem, 5vw, 4.5rem) 0.75rem;
		overflow-y: auto;
		grid-row: 2;
		align-items: safe center;
		scrollbar-width: none;
	}

	.experience-content::-webkit-scrollbar {
		display: none;
	}

	.experience-content.is-scroll-contained {
		overscroll-behavior-y: contain;
	}

	.experience-terminal {
		display: grid;
		width: 100%;
		gap: clamp(1.8rem, 4vh, 3.25rem);
	}

	.terminal-block {
		display: grid;
		gap: clamp(1rem, 2.2vh, 1.55rem);
	}

	.command-line {
		display: flex;
		margin: 0;
		align-items: baseline;
		gap: 0.8rem;
		color: var(--color-text);
		font-size: var(--terminal-font-size);
		letter-spacing: 0.015em;
		line-height: 1.4;
	}

	.command-line code {
		color: var(--color-text);
		font: inherit;
	}

	.prompt {
		display: inline-flex;
		flex: 0 0 auto;
		color: var(--color-accent);
	}

	.prompt-host {
		color: color-mix(in srgb, var(--color-text-muted) 65%, var(--color-text));
	}

	.experience-log {
		position: relative;
		display: grid;
		padding-left: var(--experience-log-padding);
		gap: 1.25rem;
		font-size: var(--experience-content-font);
		letter-spacing: -0.018em;
		line-height: var(--experience-line-height);
	}

	.experience-log::before {
		position: absolute;
		top: 0.75em;
		bottom: 0.75em;
		left: calc(var(--experience-marker-size) / 2);
		border-left: 1px solid color-mix(in srgb, var(--color-text-muted) 32%, transparent);
		content: '';
	}

	.experience-entry,
	.experience-summary {
		position: relative;
		display: grid;
		grid-template-columns: var(--experience-date-width) minmax(0, 1fr);
		column-gap: var(--experience-column-gap);
		align-items: baseline;
		line-height: var(--experience-line-height);
	}

	.experience-entry {
		padding-bottom: 1.25rem;
		border-bottom: 1px dotted var(--color-accent-muted);
	}

	.entry-marker {
		position: absolute;
		top: var(--experience-marker-offset);
		left: calc(var(--experience-log-padding) * -1);
		width: var(--experience-marker-size);
		height: var(--experience-marker-size);
		border-radius: 50%;
		background: var(--service-border);
		box-shadow: 0 0 0.35rem var(--color-accent-glow);
	}

	.entry-period {
		margin: 0;
		color: var(--service-border);
		font-size: 0.80rem;
		white-space: nowrap;
	}

	.entry-details {
		min-width: 0;
	}

	.entry-summary {
		cursor: pointer;
		list-style: none;
		list-style-type: none;
	}

	.entry-summary::-webkit-details-marker {
		display: none;
	}

	.entry-summary:focus-visible {
		outline: 1px solid var(--color-accent-muted);
		outline-offset: 3px;
	}

	.entry-title {
		display: flex;
		margin: 0 0 0.45rem;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 0 0.5rem;
		font-size: 1em;
		font-weight: 400;
	}

	.entry-role {
		color: var(--experience-magenta);
		font-weight: 600;
	}

	.entry-company {
		color: var(--color-text-muted);
		font-size: 1em;
	}

	.experience-entry ul {
		display: grid;
		margin: 0;
		padding: 0;
		gap: 0.25rem;
		list-style: none;
	}

	.experience-entry li {
		position: relative;
		padding-left: 1.35rem;
		color: color-mix(in srgb, var(--color-text) 91%, var(--color-text-muted));
		font-size: var(--terminal-font-size);
		line-height: var(--experience-line-height);
	}

	.experience-entry li::before {
		position: absolute;
		left: 0;
		color: var(--experience-magenta);
		content: '•';
	}

	.experience-summary {
		margin: 0;
		color: var(--color-text);
	}

	.summary-label {
		color: var(--experience-magenta);
		font-size: 0.82em;
		font-weight: 400;
		letter-spacing: 0.08em;
	}

	.summary-stack {
		font-size: 0.82em;
	}

	.summary-brace {
		color: var(--experience-magenta);
		font-size: 1.2em;
	}

	.interactive-block {
		display: grid;
		min-height: 1.7rem;
		gap: 0.45rem;
	}

	@media (max-width: 48rem) {
		.experience {
			--experience-header-space: calc(var(--page-inset) + var(--control-offset) + 3rem);
			--experience-footer-space: calc(var(--page-inset) + var(--control-offset) + 2.5rem);
			--experience-line-height: 1.5;
			--experience-log-padding: 1.15rem;
			--experience-column-gap: 1rem;
		}

		.experience-content {
			padding-inline: 2rem;
			align-items: start;
			scrollbar-width: initial;
		}

		.experience-content::-webkit-scrollbar {
			display: initial;
		}

		.experience-terminal {
			gap: clamp(0.55rem, 3.5vh, 1.3rem);
		}

		.terminal-block {
			gap: 0.1rem;
		}

		.command-line {
			flex-wrap: wrap;
			gap: 0.25rem 0.65rem;
			font-size: var(--terminal-font-size);
		}
	}

	@media (max-width: 36rem) {
		.experience-entry,
		.experience-summary {
			grid-template-columns: minmax(0, 1fr);
			row-gap: 0.5rem;
		}

		.entry-title {
			row-gap: 0.15rem;
		}

		.summary-stack {
			font-size: 0.9em;
		}
	}
</style>
