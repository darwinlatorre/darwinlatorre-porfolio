<a class="scroll-cue" href="#about" aria-label="Go to the next section" data-shared-scroll-cue>
	<span class="scroll-labels">
		<span data-scroll-initial>Scroll</span>
		<span data-scroll-discover>Scroll to discover</span>
	</span>
	<svg viewBox="0 0 16 10" role="presentation">
		<path d="M2 2.25 8 8l6-5.75"></path>
	</svg>
</a>

<script>
	const scrollContainer = document.querySelector<HTMLElement>('[data-page-scroll]');
	const initialLabel = document.querySelector<HTMLElement>('[data-scroll-initial]');
	const discoverLabel = document.querySelector<HTMLElement>('[data-scroll-discover]');
	const scrollCue = document.querySelector<HTMLAnchorElement>('[data-shared-scroll-cue]');

	if (scrollContainer && initialLabel && discoverLabel) {
		let frameId = 0;
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

		const render = () => {
			frameId = 0;
			const progress = Math.min(
				1,
				Math.max(0, scrollContainer.scrollTop / scrollContainer.clientHeight),
			);
			const transition = reducedMotion.matches
				? progress >= 0.85
					? 1
					: 0
				: Math.min(1, Math.max(0, (progress - 0.65) / 0.35));

			initialLabel.style.opacity = `${1 - transition}`;
			initialLabel.style.transform = `translateY(${-3 * transition}px)`;
			discoverLabel.style.opacity = `${transition}`;
			discoverLabel.style.transform = `translateY(${3 * (1 - transition)}px)`;
		};

		const requestRender = () => {
			if (frameId) return;
			frameId = window.requestAnimationFrame(render);
		};

		render();
		scrollContainer.addEventListener('scroll', requestRender, { passive: true });
		reducedMotion.addEventListener('change', requestRender);

		scrollCue?.addEventListener('click', (event) => {
			event.preventDefault();
			document.querySelector('#about')?.scrollIntoView({
				behavior: reducedMotion.matches ? 'auto' : 'smooth',
				block: 'start',
			});
		});
	}
</script>

<style>
	.scroll-cue {
		position: fixed;
		bottom: calc(var(--page-inset) + var(--control-offset));
		left: 50%;
		z-index: 30;
		display: grid;
		transform: translateX(-50%);
		place-items: center;
		gap: 0.55rem;
		color: var(--color-text-muted);
		font-size: 0.68rem;
		letter-spacing: 0.08em;
		text-decoration: none;
		cursor: pointer;
		transition: color var(--duration-fast) ease;
	}

	.scroll-cue:hover,
	.scroll-cue:focus-visible {
		color: var(--color-text);
	}

	.scroll-cue:focus-visible {
		outline: 1px solid var(--color-accent-muted);
		outline-offset: 5px;
	}

	.scroll-labels {
		display: grid;
		place-items: center;
	}

	.scroll-labels span {
		grid-area: 1 / 1;
		white-space: nowrap;
	}

	.scroll-labels span:last-child {
		opacity: 0;
	}

	.scroll-cue svg {
		width: 0.75rem;
		height: auto;
		overflow: visible;
		animation: scroll-drift 1.8s ease-in-out infinite;
	}

	.scroll-cue path {
		fill: none;
		stroke: var(--color-accent-muted);
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.25;
	}

	@keyframes scroll-drift {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(3px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.scroll-cue svg {
			animation: none;
		}
	}
</style>
