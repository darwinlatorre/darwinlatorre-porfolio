<h1 class="shared-name" data-shared-name>
	<button class="name-action" type="button" aria-label="Copy >Darwinlatorre_" data-name-action>
		<span class="prompt" aria-hidden="true">&gt;</span>
		<span>Darwinlatorre</span><span class="cursor" aria-hidden="true">_</span>
	</button>
</h1>

<script>
	const scroller = document.querySelector<HTMLElement>('[data-page-scroll]');
	const sharedName = document.querySelector<HTMLElement>('[data-shared-name]');
	const nameAction = sharedName?.querySelector<HTMLButtonElement>('[data-name-action]');
	const menu = document.querySelector<HTMLElement>('[data-menu]');
	const menuTrigger = menu?.querySelector<HTMLButtonElement>('[data-menu-trigger]');

	if (scroller && sharedName && nameAction && menu) {
		let frameId = 0;
		let feedbackTimer = 0;
		let startFontSize = 0;
		let endFontSize = 0;
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

		const measure = () => {
			sharedName.style.fontSize = '';

			startFontSize = Number.parseFloat(getComputedStyle(sharedName).fontSize);
			endFontSize = window.innerWidth <= 640 ? 13 : 15;
		};

		const render = () => {
			frameId = 0;
			const rawProgress = Math.min(1, Math.max(0, scroller.scrollTop / scroller.clientHeight));
			const progress = reducedMotion.matches ? (rawProgress >= 0.5 ? 1 : 0) : rawProgress;
			const startTop = scroller.clientHeight / 2;
			const endTop = Number.parseFloat(getComputedStyle(menu).top);
			const fontSize = startFontSize + (endFontSize - startFontSize) * progress;
			const top = startTop + (endTop - startTop) * progress;
			const translateY = -50 * (1 - progress);
			const menuProgress = Math.min(1, progress * 1.5);

			sharedName.style.top = `${top}px`;
			sharedName.style.fontSize = `${fontSize}px`;
			sharedName.style.transform = `translate(-50%, ${translateY}%)`;
			menu.style.opacity = `${1 - menuProgress}`;
			menu.inert = menuProgress > 0.5;
			menu.setAttribute('aria-hidden', String(menuProgress > 0.5));
			nameAction.setAttribute(
				'aria-label',
				rawProgress >= 0.5 ? 'Return to home' : 'Copy >Darwinlatorre_',
			);

			if (menuProgress > 0 && menuTrigger?.getAttribute('aria-expanded') === 'true') {
				menuTrigger.click();
			}
		};

		const requestRender = () => {
			if (frameId) return;
			frameId = window.requestAnimationFrame(render);
		};

		measure();
		render();
		scroller.addEventListener('scroll', requestRender, { passive: true });
		window.addEventListener('resize', () => {
			measure();
			requestRender();
		});
		reducedMotion.addEventListener('change', requestRender);

		nameAction.addEventListener('click', async () => {
			const inSecondSection = scroller.scrollTop / scroller.clientHeight >= 0.5;

			if (inSecondSection) {
				document.querySelector('#home')?.scrollIntoView({
					behavior: reducedMotion.matches ? 'auto' : 'smooth',
					block: 'start',
				});
				return;
			}

			const value = '>Darwinlatorre_';

			try {
				await navigator.clipboard.writeText(value);
			} catch {
				const textarea = document.createElement('textarea');
				textarea.value = value;
				textarea.style.position = 'fixed';
				textarea.style.opacity = '0';
				document.body.append(textarea);
				textarea.select();
				document.execCommand('copy');
				textarea.remove();
			}

			nameAction.dataset.copied = 'true';
			window.clearTimeout(feedbackTimer);
			feedbackTimer = window.setTimeout(() => {
				delete nameAction.dataset.copied;
			}, 1200);
		});
	}
</script>

<style>
	.shared-name {
		position: fixed;
		top: 50%;
		left: 50%;
		z-index: 30;
		display: flex;
		margin: 0;
		align-items: baseline;
		transform: translate(-50%, -50%);
		white-space: nowrap;
		color: var(--color-text);
		font-size: clamp(1.45rem, 7.25vw, 3.5rem);
		font-weight: 500;
		letter-spacing: -0.045em;
		line-height: 1;
		pointer-events: none;
	}

	.name-action {
		position: relative;
		display: flex;
		padding: 0;
		align-items: baseline;
		border: 0;
		background: transparent;
		color: inherit;
		font: inherit;
		letter-spacing: inherit;
		line-height: inherit;
		cursor: pointer;
		pointer-events: auto;
	}

	.name-action::after {
		position: absolute;
		top: calc(100% + 0.75rem);
		left: 50%;
		color: var(--color-text-muted);
		content: 'Copied';
		font-size: 0.62rem;
		font-weight: 400;
		letter-spacing: 0.02em;
		opacity: 0;
		transform: translate(-50%, 3px);
		transition: opacity var(--duration-fast) ease, transform var(--duration-fast) ease;
	}

	.name-action[data-copied='true']::after {
		opacity: 1;
		transform: translate(-50%, 0);
	}

	.name-action:focus-visible {
		outline: 1px solid var(--color-accent-muted);
		outline-offset: 6px;
	}

	.prompt {
		display: inline-block;
		margin-right: 0.32em;
		color: var(--color-accent);
		text-shadow: 0 0 7px var(--color-accent-glow);
	}

	.cursor {
		color: var(--color-accent);
		text-shadow: 0 0 7px var(--color-accent-glow-faint);
		animation: cursor-blink 1.2s step-end infinite;
	}

	@keyframes cursor-blink {
		0%,
		45% {
			opacity: 1;
		}
		46%,
		100% {
			opacity: 0.16;
		}
	}

	@media (max-width: 40rem) {
		.shared-name {
			letter-spacing: -0.055em;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.cursor {
			animation: none;
		}
	}
</style>
