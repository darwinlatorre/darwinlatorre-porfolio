---
import Home from '../components/home/Home.astro';
import MenuButton from '../components/home/MenuButton.astro';
import SharedName from '../components/common/SharedName.astro';
import SharedScrollCue from '../components/common/SharedScrollCue.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
	<MenuButton id="site-menu" />
	<SharedName />
	<SharedScrollCue />

	<main class="page-scroll" data-page-scroll>
		<Home />
	</main>
</BaseLayout>

<style>
	.page-scroll {
		display: flex;
		width: 100%;
		height: 100vh;
		height: 100dvh;
		overflow-x: hidden;
		overflow-y: auto;
		flex-direction: column;
		scroll-behavior: smooth;
		scroll-snap-type: y mandatory;
		scrollbar-width: none;
	}

	.page-scroll::-webkit-scrollbar {
		display: none;
	}
</style>
