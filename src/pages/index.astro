---
import About from '../components/about/About.astro';
import Certificates from '../components/certificates/Certificates.astro';
import Experience from '../components/experience/Experience.astro';
import Home from '../components/home/Home.astro';
import Projects from '../components/projects/Projects.astro';
import Services from '../components/services/Services.astro';
import TechnologyDialog from '../components/about/TechnologyDialog.astro';
import MenuButton from '../components/shell/MenuButton.astro';
import SharedName from '../components/shell/SharedName.astro';
import SharedScrollCue from '../components/shell/SharedScrollCue.astro';
import SiteFooter from '../components/shell/SiteFooter.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
	<MenuButton id="site-menu" />
	<SharedName />
	<SharedScrollCue />
	<TechnologyDialog />

	<main class="page-scroll" data-page-scroll>
		<Home />
		<About />
		<Projects />
		<Experience />
		<Services />
		<Certificates />
		<SiteFooter />
	</main>
</BaseLayout>

<script>
	import '../scripts/terminal-interactions';
	import '../scripts/cv-dialog';
	import '../scripts/page-scroll';
</script>

<style>
	.page-scroll {
		display: flex;
		width: 100%;
		height: 100vh;
		height: 100dvh;
		overflow-x: hidden;
		overflow-y: auto;
		flex-direction: column;
		scroll-behavior: smooth;
		scroll-snap-type: y mandatory;
		scrollbar-width: none;
	}

	.page-scroll::-webkit-scrollbar {
		display: none;
	}

	@media (max-width: 48rem) {
		/* Let touch scrolling chain to the next snap target at content edges. */
		.page-scroll :global(.is-scroll-contained) {
			overscroll-behavior-y: auto;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.page-scroll {
			scroll-behavior: auto;
		}
	}
</style>
