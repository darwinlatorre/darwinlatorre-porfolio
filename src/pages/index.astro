---
import About from '../components/about/About.astro';
import Certificates from '../components/certificates/Certificates.astro';
import Experience from '../components/experience/Experience.astro';
import Home from '../components/home/Home.astro';
import Projects from '../components/projects/Projects.astro';
import Services from '../components/services/Services.astro';
import TechnologyDialog from '../components/about/TechnologyDialog.astro';
import MenuButton from '../components/shell/MenuButton.astro';
import SharedName from '../components/shell/SharedName.astro';
import SharedScrollCue from '../components/shell/SharedScrollCue.astro';
import SiteFooter from '../components/shell/SiteFooter.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
	<MenuButton id="site-menu" />
	<SharedName />
	<SharedScrollCue />
	<TechnologyDialog />

	<main class="page-scroll" data-page-scroll>
		<Home />
		<About />
		<Projects />
		<Experience />
		<Services />
		<Certificates />
		<SiteFooter />
	</main>
</BaseLayout>

<script>
	import '../scripts/terminal-interactions';
	import '../scripts/cv-dialog';
	import '../scripts/page-scroll';
</script>

<style>
	.page-scroll {
		display: flex;
		width: 100%;
		height: 100vh;
		height: 100dvh;
		overflow-x: hidden;
		overflow-y: auto;
		flex-direction: column;
		scroll-behavior: smooth;
		scroll-snap-type: y mandatory;
		scrollbar-width: none;
	}

	.page-scroll::-webkit-scrollbar {
		display: none;
	}

	@media (max-width: 48rem) {
		.page-scroll {
			scroll-snap-type: none;
			scroll-behavior: auto;
		}

		/* One native scroll surface preserves touch momentum across sections. */
		.page-scroll :global(section.screen:not(.home-details)) {
			display: block;
			flex: 0 0 auto;
			padding-block: calc(var(--page-inset) + var(--control-offset) + 3rem)
				calc(var(--page-inset) + var(--control-offset) + 2.5rem);
			overflow: visible;
			scroll-snap-align: none;
		}

		.page-scroll :global([data-about-content]),
		.page-scroll :global([data-projects-content]),
		.page-scroll :global([data-experience-content]),
		.page-scroll :global([data-services-content]),
		.page-scroll :global([data-certificates-content]) {
			height: auto;
			overflow: visible;
			align-content: start;
			overscroll-behavior-y: auto;
		}

		.page-scroll :global(.description-output p) {
			max-height: none;
			overflow: visible;
		}

		.page-scroll :global(.site-footer) {
			margin-top: 0;
			scroll-snap-align: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.page-scroll {
			scroll-behavior: auto;
		}
	}
</style>
